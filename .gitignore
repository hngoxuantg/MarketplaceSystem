# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg
# The packages folder can be ignored because of Package Restore
**/[Pp]ackages/*
# except build/, which is used as MSBuild target
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# Visual Studio cache files
# files ending in .cache can be ignored
*.[Cc]ache
# but keep track of directories ending in .cache
!?*.[Cc]ache/

# SQL Server files
*.mdf
*.ldf
*.ndf

# Sensitive config files
**/appsettings.*.json
!**/appsettings.json
!**/appsettings.Development.json

# Microsoft Azure Web App publish settings
*.pubxml
*.publishproj
*.pubxml.user

# Local development settings
local.settings.json
launchSettings.json

node_modules/
.fake

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log

# Temporary files
*.tmp
*.temp
