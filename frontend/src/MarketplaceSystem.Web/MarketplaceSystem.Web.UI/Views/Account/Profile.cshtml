@model MarketplaceSystem.Web.UI.Models.ViewModels.User.UserInfoViewModel

@{
    ViewBag.Title = "Hồ sơ cá nhân";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/profile.css" />
}

<div class="profile-page">
    <div class="container">
        <!-- Header -->
        <div class="profile-header">
            <div class="header-content">
                <div class="header-icon">
                    <i class="fas fa-user-circle"></i>
                </div>
                <div>
                    <h1>Hồ sơ cá nhân</h1>
                    <p>
                        <i class="fas fa-info-circle"></i>
                        Quản lý thông tin cá nhân của bạn
                    </p>
                </div>
            </div>
        </div>

        <div class="profile-content">
            <!-- Avatar Section -->
            <div class="avatar-section">
                <div class="avatar-card">
                    <div class="avatar-wrapper">
                        <img src="@(string.IsNullOrEmpty(Model.Avatar) ? "/images/default-avatar.png" : Model.Avatar)" 
                             alt="Avatar" 
                             id="avatarPreview" 
                             class="avatar-image" />
                        <div class="avatar-overlay">
                            <label for="avatarInput" class="avatar-upload-btn">
                                <i class="fas fa-camera"></i>
                                <span>Đổi ảnh</span>
                            </label>
                        </div>
                        <input type="file" 
                               id="avatarInput" 
                               accept="image/*" 
                               style="display: none;" 
                               onchange="uploadAvatar(this)" />
                    </div>
                    <div class="avatar-info">
                        <h3>@Model.FullName</h3>
                        <p>@Model.Email</p>
                        @if (Model.Roles.Any())
                        {
                            <div class="user-badges">
                                @foreach (var role in Model.Roles)
                                {
                                    <span class="badge badge-role">@role</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Info Section -->
            <div class="info-section">
                <div class="info-card">
                    <div class="card-header">
                        <h2>
                            <i class="fas fa-user-edit"></i>
                            Thông tin cá nhân
                        </h2>
                    </div>
                    <form id="profileForm" class="profile-form">
                        <div class="form-group">
                            <label for="fullName">
                                <i class="fas fa-user"></i>
                                Họ và tên
                            </label>
                            <input type="text" 
                                   id="fullName" 
                                   name="fullName" 
                                   class="form-control" 
                                   value="@Model.FullName" 
                                   required />
                        </div>

                        <div class="form-group">
                            <label for="email">
                                <i class="fas fa-envelope"></i>
                                Email
                            </label>
                            <input type="email" 
                                   id="email" 
                                   name="email" 
                                   class="form-control" 
                                   value="@Model.Email" 
                                   readonly 
                                   disabled />
                            <small class="form-text">Email không thể thay đổi</small>
                        </div>

                        <div class="form-group">
                            <label for="phoneNumber">
                                <i class="fas fa-phone"></i>
                                Số điện thoại
                            </label>
                            <input type="tel" 
                                   id="phoneNumber" 
                                   name="phoneNumber" 
                                   class="form-control" 
                                   value="@Model.PhoneNumber" 
                                   placeholder="Nhập số điện thoại" />
                        </div>

                        <div class="form-actions">
                            <button type="button" class="btn-cancel" onclick="resetForm()">
                                <i class="fas fa-times"></i>
                                Hủy
                            </button>
                            <button type="submit" class="btn-save">
                                <i class="fas fa-save"></i>
                                Lưu thay đổi
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Security Card -->
                <div class="info-card">
                    <div class="card-header">
                        <h2>
                            <i class="fas fa-shield-alt"></i>
                            Bảo mật
                        </h2>
                    </div>
                    <div class="security-options">
                        <div class="security-item">
                            <div class="security-info">
                                <i class="fas fa-key"></i>
                                <div>
                                    <h4>Mật khẩu</h4>
                                    <p>Thay đổi mật khẩu của bạn</p>
                                </div>
                            </div>
                            <button class="btn-action" onclick="window.location.href='/Account/ChangePassword'">
                                Thay đổi
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Stats Card -->
                <div class="info-card">
                    <div class="card-header">
                        <h2>
                            <i class="fas fa-chart-line"></i>
                            Thống kê
                        </h2>
                    </div>
                    <div class="stats-grid">
                        <div class="stat-item">
                            <div class="stat-icon">
                                <i class="fas fa-box"></i>
                            </div>
                            <div class="stat-info">
                                <h4>Tin đăng</h4>
                                <p class="stat-value" id="totalPosts">0</p>
                            </div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-icon">
                                <i class="fas fa-heart"></i>
                            </div>
                            <div class="stat-info">
                                <h4>Yêu thích</h4>
                                <p class="stat-value" id="totalFavorites">0</p>
                            </div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-icon">
                                <i class="fas fa-calendar"></i>
                            </div>
                            <div class="stat-info">
                                <h4>Thành viên từ</h4>
                                <p class="stat-value">2025</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Original values for reset
        const originalValues = {
            fullName: '@Model.FullName',
            phoneNumber: '@Model.PhoneNumber'
        };

        // Upload Avatar
        async function uploadAvatar(input) {
            const file = input.files[0];
            if (!file) return;

            // Validate file type
            if (!file.type.startsWith('image/')) {
                if (window.Toast) {
                    window.Toast.error('Vui lòng chọn file ảnh!');
                }
                return;
            }

            // Validate file size (max 5MB)
            if (file.size > 5 * 1024 * 1024) {
                if (window.Toast) {
                    window.Toast.error('Kích thước ảnh không được vượt quá 5MB!');
                }
                return;
            }

            // Preview image
            const reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('avatarPreview').src = e.target.result;
            };
            reader.readAsDataURL(file);

            // Upload to server
            const formData = new FormData();
            formData.append('avatar', file);

            try {
                if (window.Toast) {
                    window.Toast.info('Đang tải ảnh lên...');
                }

                const response = await fetch('/Account/UploadAvatar', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();

                if (result.success) {
                    if (window.Toast) {
                        window.Toast.success('Cập nhật ảnh đại diện thành công!');
                    }
                    
                    // Update avatar in header if exists
                    const headerAvatar = document.querySelector('.user-avatar img');
                    if (headerAvatar && result.avatarUrl) {
                        headerAvatar.src = result.avatarUrl;
                    }
                } else {
                    if (window.Toast) {
                        window.Toast.error(result.message || 'Tải ảnh lên thất bại!');
                    }
                    // Revert preview
                    document.getElementById('avatarPreview').src = '@(string.IsNullOrEmpty(Model.Avatar) ? "/images/default-avatar.png" : Model.Avatar)';
                }
            } catch (error) {
                console.error('Upload error:', error);
                if (window.Toast) {
                    window.Toast.error('Có lỗi xảy ra khi tải ảnh lên!');
                }
                // Revert preview
                document.getElementById('avatarPreview').src = '@(string.IsNullOrEmpty(Model.Avatar) ? "/images/default-avatar.png" : Model.Avatar)';
            }

            // Clear input
            input.value = '';
        }

        // Reset Form
        function resetForm() {
            document.getElementById('fullName').value = originalValues.fullName;
            document.getElementById('phoneNumber').value = originalValues.phoneNumber;
        }

        // Submit Form
        document.getElementById('profileForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const formData = {
                fullName: document.getElementById('fullName').value.trim(),
                phoneNumber: document.getElementById('phoneNumber').value.trim()
            };

            // Validate
            if (!formData.fullName) {
                if (window.Toast) {
                    window.Toast.warning('Vui lòng nhập họ tên!');
                }
                return;
            }

            try {
                const response = await fetch('/Account/UpdateProfile', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(formData)
                });

                const result = await response.json();

                if (result.success) {
                    if (window.Toast) {
                        window.Toast.success('Cập nhật thông tin thành công!');
                    }
                    // Update original values
                    originalValues.fullName = formData.fullName;
                    originalValues.phoneNumber = formData.phoneNumber;
                } else {
                    if (window.Toast) {
                        window.Toast.error(result.message || 'Cập nhật thông tin thất bại!');
                    }
                }
            } catch (error) {
                console.error('Update error:', error);
                if (window.Toast) {
                    window.Toast.error('Có lỗi xảy ra khi cập nhật thông tin!');
                }
            }
        });

        // Load Stats
        (function loadStats() {
            // Load favorites count from localStorage
            const favoritesData = localStorage.getItem('favoriteProducts');
            const favorites = favoritesData ? JSON.parse(favoritesData) : [];
            document.getElementById('totalFavorites').textContent = favorites.length;

            // TODO: Load posts count from API
            // fetch('/Account/GetUserStats').then(...)
        })();
    </script>
}
