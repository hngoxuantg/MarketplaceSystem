@model MarketplaceSystem.Web.UI.Models.ViewModels.Product.ProductListViewModel
@{
    ViewBag.Title = "Quản lý tin đăng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .my-posts-container {
            max-width: 1200px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .page-header {
            margin-bottom: 30px;
            border-bottom: 1px solid #e5e5e5;
            padding-bottom: 20px;
        }

        .page-header h1 {
            font-size: 24px;
            font-weight: 600;
            color: #333;
            margin: 0 0 8px 0;
        }

        .page-header p {
            color: #666;
            margin: 0;
            font-size: 14px;
        }

        .btn-new-post {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: #007bff;
            color: white;
            padding: 10px 20px;
            border-radius: 4px;
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            margin-top: 15px;
            transition: background 0.2s;
        }

        .btn-new-post:hover {
            background: #0056b3;
            color: white;
        }

        .posts-table {
            background: white;
            border: 1px solid #e5e5e5;
            border-radius: 4px;
            overflow: hidden;
        }

        .posts-table table {
            width: 100%;
            border-collapse: collapse;
        }

        .posts-table thead {
            background: #f8f9fa;
            border-bottom: 1px solid #e5e5e5;
        }

        .posts-table th {
            padding: 12px 16px;
            text-align: left;
            font-weight: 600;
            font-size: 13px;
            color: #555;
        }

        .posts-table td {
            padding: 16px;
            border-bottom: 1px solid #f0f0f0;
            font-size: 14px;
        }

        .posts-table tbody tr:last-child td {
            border-bottom: none;
        }

        .posts-table tbody tr:hover {
            background: #fafafa;
        }

        .product-info {
            display: flex;
            gap: 12px;
            align-items: center;
        }

        .product-thumb {
            width: 60px;
            height: 60px;
            object-fit: cover;
            border-radius: 4px;
            border: 1px solid #e5e5e5;
            flex-shrink: 0;
        }

        .product-details {
            flex: 1;
            min-width: 0;
        }

        .product-title {
            font-weight: 500;
            color: #333;
            margin: 0 0 4px 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .product-meta {
            font-size: 13px;
            color: #666;
        }

        .product-price {
            font-weight: 600;
            color: #d32f2f;
            white-space: nowrap;
        }

        .product-status {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 3px;
            font-size: 12px;
            font-weight: 500;
        }

        .status-active {
            background: #e8f5e9;
            color: #2e7d32;
        }

        .status-sold {
            background: #fff3e0;
            color: #e65100;
        }

        .action-buttons {
            display: flex;
            gap: 8px;
            justify-content: flex-end;
        }

        .btn-action {
            padding: 6px 12px;
            border: 1px solid #ddd;
            background: white;
            border-radius: 3px;
            font-size: 13px;
            cursor: pointer;
            transition: all 0.2s;
            color: #555;
        }

        .btn-action:hover {
            background: #f5f5f5;
        }

        .btn-sold {
            border-color: #ff9800;
            color: #ff9800;
        }

        .btn-sold:hover {
            background: #fff3e0;
        }

        .btn-delete {
            border-color: #dc3545;
            color: #dc3545;
        }

        .btn-delete:hover {
            background: #ffebee;
        }

        .btn-action:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #666;
        }

        .empty-state svg {
            width: 120px;
            height: 120px;
            margin-bottom: 20px;
        }

        .empty-state h2 {
            font-size: 20px;
            color: #333;
            margin-bottom: 8px;
        }

        .empty-state p {
            margin-bottom: 24px;
        }

        .pagination-wrapper {
            margin-top: 20px;
            display: flex;
            justify-content: center;
        }

    </style>
}

<div class="my-posts-container">
    <div class="page-header">
        <h1>Quản lý tin đăng</h1>
        <p>Tổng số tin: @(Model?.TotalCount ?? 0)</p>
        <a href="@Url.Action("SelectCategory", "Post")" class="btn-new-post">
            <i class="fas fa-plus"></i>
            <span>Đăng tin mới</span>
        </a>
    </div>

    @if (Model?.Items != null && Model.Items.Any())
    {
        <div class="posts-table">
            <table>
                <thead>
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Giá</th>
                        <th>Trạng thái</th>
                        <th>Ngày đăng</th>
                        <th style="text-align: right;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var product in Model.Items)
                    {
                        <tr data-id="@product.Id">
                            <td>
                                <div class="product-info">
                                    <img src="@product.ImageUrlOrDefault" alt="@product.Title" class="product-thumb" />
                                    <div class="product-details">
                                        <h3 class="product-title">@product.Title</h3>
                                        <div class="product-meta">
                                            <i class="fas fa-map-marker-alt"></i> @product.Location
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="product-price">@product.FormattedPrice</span>
                            </td>
                            <td>
                                <span class="product-status @(product.ProductStatus == "Đã bán" ? "status-sold" : "status-active")">
                                    @product.ProductStatus
                                </span>
                            </td>
                            <td>@product.TimeAgo</td>
                            <td>
                                <div class="action-buttons">
                                    @if (product.ProductStatus != "Đã bán")
                                    {
                                        <button class="btn-action btn-sold" onclick="markAsSold(@product.Id)" title="Đánh dấu đã bán">
                                            <i class="fas fa-check"></i> Đã bán
                                        </button>
                                    }
                                    <button class="btn-action btn-delete" onclick="deletePost(@product.Id, '@product.Title')" title="Gỡ tin">
                                        <i class="fas fa-trash"></i> Gỡ tin
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="pagination-wrapper">
                @await Component.InvokeAsync("Pagination", Model)
            </div>
        }
    }
    else
    {
        <div class="empty-state">
            <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="100" cy="100" r="60" stroke="#e0e0e0" stroke-width="2"/>
                <path d="M70 90h60M70 110h40" stroke="#bdbdbd" stroke-width="2" stroke-linecap="round"/>
            </svg>
            <h2>Chưa có tin đăng</h2>
            <p>Bạn chưa đăng tin nào. Hãy bắt đầu đăng tin để bán sản phẩm của bạn.</p>
            <a href="@Url.Action("SelectCategory", "Post")" class="btn-new-post">
                Đăng tin đầu tiên
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        function markAsSold(productId) {
            if (!confirm('Đánh dấu sản phẩm này là đã bán?')) {
                return;
            }

            const btn = event.target.closest('button');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Đang xử lý...';

            fetch('@Url.Action("MarkAsSold", "Post")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ id: productId })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showToast(data.message || 'Đã đánh dấu sản phẩm là đã bán', 'success');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showToast(data.message || 'Có lỗi xảy ra', 'error');
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-check"></i> Đã bán';
                }
            })
            .catch(error => {
                showToast('Có lỗi xảy ra khi đánh dấu sản phẩm', 'error');
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-check"></i> Đã bán';
            });
        }

        function deletePost(productId, title) {
            if (!confirm(`Bạn có chắc muốn gỡ tin "${title}"?\n\nHành động này không thể hoàn tác.`)) {
                return;
            }

            const btn = event.target.closest('button');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Đang xóa...';

            fetch('@Url.Action("Delete", "Post")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ id: productId })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showToast(data.message || 'Đã gỡ tin thành công', 'success');
                    // Remove row with animation
                    const row = document.querySelector(`tr[data-id="${productId}"]`);
                    if (row) {
                        row.style.transition = 'opacity 0.3s';
                        row.style.opacity = '0';
                        setTimeout(() => {
                            row.remove();
                            // Reload if no items left
                            if (document.querySelectorAll('.posts-table tbody tr').length === 0) {
                                location.reload();
                            }
                        }, 300);
                    }
                } else {
                    showToast(data.message || 'Có lỗi xảy ra', 'error');
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-trash"></i> Gỡ tin';
                }
            })
            .catch(error => {
                showToast('Có lỗi xảy ra khi gỡ tin', 'error');
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-trash"></i> Gỡ tin';
            });
        }
    </script>
}
