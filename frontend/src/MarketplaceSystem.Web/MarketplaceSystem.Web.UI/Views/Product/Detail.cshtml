@model MarketplaceSystem.Web.UI.Models.ViewModels.Product.ProductDetailViewModel

@{
    ViewData["Title"] = Model.Title;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/product-detail.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
}

<div class="product-detail-page">
    <div class="container">
        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="product-breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="#">Danh mục</a></li>
                <li class="breadcrumb-item active">@Model.Title</li>
            </ol>
        </nav>

        <!-- Main Content -->
        <div class="product-layout">
            <!-- Left Column -->
            <div class="product-main">
                <!-- Image Gallery -->
                <div class="image-gallery">
                    <div class="main-image">
                        <img src="@Model.Images.Images[0].ImageUrl" alt="@Model.Title" id="mainImage">
                        @if (Model.Images.TotalImages > 1)
                        {
                            <div class="image-count">1/@Model.Images.TotalImages</div>
                        }
                    </div>

                    @if (Model.Images.TotalImages > 1)
                    {
                        <div class="thumbnail-grid">
                            @for (int i = 0; i < Model.Images.Images.Count; i++)
                            {
                                <div class="thumbnail @(i == 0 ? "active" : "")" onclick="changeImage(@i, '@Model.Images.Images[i].ImageUrl')">
                                    <img src="@Model.Images.Images[i].ImageUrl" alt="Ảnh @(i + 1)">
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Product Info -->
                <div class="product-info">
                    <h1 class="product-title">@Model.Title</h1>

                    <div class="product-price">@Model.FormattedPrice</div>

                    <div class="product-meta">
                        <span><i class="bi bi-geo-alt-fill"></i> @Model.Location</span>
                        <span><i class="bi bi-clock-fill"></i> @Model.TimeAgo</span>
                        <span><i class="bi bi-tag-fill"></i> @Model.ConditionText</span>
                    </div>

                    <div class="product-actions">
                        <button class="btn btn-primary btn-call">
                            <i class="bi bi-telephone-fill"></i>
                            Hiện số điện thoại
                        </button>
                        <button class="btn btn-secondary btn-chat" data-seller-id="@Model.Seller.UserId" data-seller-name="@Model.Seller.DisplayName" onclick="openChatWithSeller(this)">
                            <i class="bi bi-chat-dots-fill"></i>
                            Chat ngay
                        </button>
                        <button class="btn btn-icon btn-save" id="btnSaveFavorite" onclick="toggleFavoriteDetail(@Model.Id)">
                            <i class="bi bi-heart"></i>
                        </button>
                    </div>
                </div>

                <!-- Description -->
                <div class="product-section">
                    <h2 class="section-title">Mô tả chi tiết</h2>
                    <div class="description-content">
                        @if (!string.IsNullOrEmpty(Model.Description))
                        {
                            <p>@Model.Description</p>
                        }
                        else
                        {
                            <p class="text-muted">Người bán chưa cập nhật mô tả chi tiết.</p>
                        }
                    </div>
                </div>

                <!-- Specifications - CHỈ HIỂN THỊ ATTRIBUTE VALUES -->
                @if (Model.AttributeValues?.Any() == true)
                {
                    <div class="product-section">
                        <h2 class="section-title">Thông tin chi tiết</h2>
                        <div class="specs-grid">
                            @foreach (var attr in Model.AttributeValues)
                            {
                                <div class="spec-item">
                                    <div class="spec-label">@attr.AttributeName</div>
                                    <div class="spec-value">
                                        @if (!string.IsNullOrEmpty(attr.SelectsValue))
                                        {
                                            @attr.SelectsValue
                                        }
                                        else if (attr.NumberValue.HasValue)
                                        {
                                            @attr.NumberValue.Value
                                        }
                                        else if (attr.BooleanValue.HasValue)
                                        {
                                            <span>@(attr.BooleanValue.Value ? "Có" : "Không")</span>
                                        }
                                        else if (attr.DateValue.HasValue)
                                        {
                                            @attr.DateValue.Value.ToString("dd/MM/yyyy")
                                        }
                                        else if (!string.IsNullOrEmpty(attr.TextValue))
                                        {
                                            @attr.TextValue
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Right Column - Seller Info -->
            <div class="product-sidebar">
                <div class="seller-card">
                    <div class="seller-header">
                        <div class="seller-avatar">
                            @if (Model.Seller.AvatarUrl != null && !Model.Seller.AvatarUrl.Contains("default-avatar"))
                            {
                                <img src="@Model.Seller.AvatarUrlOrDefault" alt="@Model.Seller.DisplayName">
                            }
                            else
                            {
                                <div class="avatar-placeholder">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                            }
                        </div>
                        <div class="seller-info">
                            <h3 class="seller-name">@Model.Seller.DisplayName</h3>
                            <div class="seller-status">
                                <i class="bi bi-circle-fill online"></i>
                                <span>Hoạt động @Model.CreatedAt.ToString("HH:mm")</span>
                            </div>
                        </div>
                    </div>

                    <div class="seller-stats">
                        <div class="stat-item">
                            <div class="stat-value">@Model.Seller.TotalProducts</div>
                            <div class="stat-label">Sản phẩm</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-value">@Model.Seller.RatingText</div>
                            <div class="stat-label">Đánh giá</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-value">@Model.Seller.JoinedText</div>
                            <div class="stat-label">Tham gia</div>
                        </div>
                    </div>

                    <button class="btn btn-outline btn-block">
                        <i class="bi bi-shop"></i>
                        Xem trang
                    </button>
                </div>

                <!-- Quick Chat -->
                <div class="quick-chat-card">
                    <h4 class="quick-chat-title">
                        <i class="bi bi-chat-dots-fill"></i>
                        Chat nhanh
                    </h4>
                    <div class="quick-chat-list">
                        <button class="quick-chat-btn" data-message="Sản phẩm còn không?" onclick="sendQuickMessage(this, @Model.Seller.UserId, '@Model.Seller.DisplayName')">Sản phẩm còn không?</button>
                        <button class="quick-chat-btn" data-message="Bạn có ship hàng không?" onclick="sendQuickMessage(this, @Model.Seller.UserId, '@Model.Seller.DisplayName')">Bạn có ship hàng không?</button>
                        <button class="quick-chat-btn" data-message="Còn bảo hành không?" onclick="sendQuickMessage(this, @Model.Seller.UserId, '@Model.Seller.DisplayName')">Còn bảo hành không?</button>
                    </div>
                </div>

                <!-- Safety Tips -->
                <div class="safety-card">
                    <h4 class="safety-title">
                        <i class="bi bi-shield-check-fill"></i>
                        Lưu ý an toàn
                    </h4>
                    <ul class="safety-list">
                        <li><i class="bi bi-check-circle-fill"></i> Không chuyển tiền trước khi nhận hàng</li>
                        <li><i class="bi bi-check-circle-fill"></i> Kiểm tra kỹ trước khi thanh toán</li>
                        <li><i class="bi bi-check-circle-fill"></i> Gặp mặt tại nơi công cộng</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function changeImage(index, imageUrl) {
            document.getElementById('mainImage').src = imageUrl;
            document.querySelectorAll('.thumbnail').forEach((thumb, i) => {
                thumb.classList.toggle('active', i === index);
            });
            document.querySelector('.image-count').textContent = (index + 1) + '/@Model.Images.TotalImages';
        }

        document.querySelector('.btn-call')?.addEventListener('click', function() {
            const phoneNumber = '@Model.Seller.PhoneNumber';
            this.innerHTML = '<i class="bi bi-telephone-fill"></i> ' + phoneNumber;
            this.disabled = true;
        });

        // Toggle favorite for product detail page
        function toggleFavoriteDetail(productId) {
            const btn = document.getElementById('btnSaveFavorite');
            const icon = btn.querySelector('i');
            
            // Get current favorites from localStorage
            const favorites = window.storage.get('favoriteProducts') || [];
            const isFavorite = favorites.includes(productId);

            if (isFavorite) {
                // Remove from favorites
                const index = favorites.indexOf(productId);
                favorites.splice(index, 1);
                window.storage.set('favoriteProducts', favorites);
                
                icon.classList.remove('bi-heart-fill');
                icon.classList.add('bi-heart');
                btn.classList.remove('active');
                
                showToast('Đã xóa khỏi yêu thích', 'info');
            } else {
                // Add to favorites
                favorites.push(productId);
                window.storage.set('favoriteProducts', favorites);
                
                icon.classList.remove('bi-heart');
                icon.classList.add('bi-heart-fill');
                btn.classList.add('active');
                
                showToast('Đã thêm vào yêu thích', 'success');
            }
        }

        // Load favorite state on page load
        window.addEventListener('DOMContentLoaded', function() {
            const productId = @Model.Id;
            const favorites = window.storage.get('favoriteProducts') || [];
            
            if (favorites.includes(productId)) {
                const btn = document.getElementById('btnSaveFavorite');
                const icon = btn.querySelector('i');
                icon.classList.remove('bi-heart');
                icon.classList.add('bi-heart-fill');
                btn.classList.add('active');
            }
        });

        // Open chat with seller
        function openChatWithSeller(button) {
            const sellerId = button.getAttribute('data-seller-id');
            const sellerName = button.getAttribute('data-seller-name');
            
            if (!sellerId) {
                showToast('Không tìm thấy thông tin người bán', 'error');
                return;
            }
            
            // Redirect to chat page with seller info
            window.location.href = `/Chat?userId=${sellerId}&userName=${encodeURIComponent(sellerName)}`;
        }

        // Send quick message to seller
        function sendQuickMessage(button, sellerId, sellerName) {
            const message = button.getAttribute('data-message');
            
            if (!sellerId) {
                showToast('Không tìm thấy thông tin người bán', 'error');
                return;
            }
            
            // Store quick message in sessionStorage to send after navigation
            sessionStorage.setItem('quickMessage', JSON.stringify({
                receiverId: sellerId,
                receiverName: sellerName,
                message: message
            }));
            
            // Redirect to chat page
            window.location.href = `/Chat?userId=${sellerId}&userName=${encodeURIComponent(sellerName)}&quickMsg=true`;
        }
    </script>
}