<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>@ViewBag.Title - Marketplace</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link rel="stylesheet" href="~/css/common.css" />
    <link rel="stylesheet" href="~/css/components/toast-notification.css" />
    @RenderSection("Styles", required: false)

</head>
<body>
    <div id="layout">
        <header class="header">
            <div class="logo">
                <a href="/"><img src="https://static.chotot.com/storage/marketplace/transparent_logo.png" alt="Marketplace Logo" /></a>
            </div>
            <nav class="menu">
                <a href="@Url.Action("Index", "Home")">Trang chủ</a>
                <a href="@Url.Action("Index", "Home")#categories">Danh mục</a>
                <a href="@Url.Action("Index", "Home")#products">Sản phẩm</a>
                <a href="@Url.Action("About", "Home")">Về chúng tôi</a>
            </nav>
            <div class="actions">
                <a asp-controller="Post" asp-action="SelectCategory" class="post-btn">
                    <i class="fas fa-plus-circle"></i>
                    Đăng tin
                </a>
                @await Component.InvokeAsync("UserInfo")
            </div>
        </header>

        <main class="main-content">
            @RenderBody()
        </main>

        <footer class="site-footer">
            <section class="footer-hero">
                <div class="footer-hero__content">
                    <h2 class="footer-hero__title">Mua thì hời, bán thì lời</h2>
                    <p class="footer-hero__subtitle">Tải app ngay!</p>
                    <div class="footer-hero__actions">
                        <a href="#" class="store-btn store-btn--apple">
                            <i class="fab fa-apple"></i>
                            <span>
                                <small>Tải trên</small>
                                App Store
                            </span>
                        </a>
                        <a href="#" class="store-btn store-btn--play">
                            <i class="fab fa-google-play"></i>
                            <span>
                                <small>Nhận trên</small>
                                Google Play
                            </span>
                        </a>
                    </div>
                </div>
            </section>

            <section class="footer-links">
                <div class="footer-col">
                    <h4 class="footer-col__title">Tải ứng dụng</h4>
                    <ul class="footer-col__list">
                        <li><a href="#">Marketplace iOS</a></li>
                        <li><a href="#">Marketplace Android</a></li>
                    </ul>
                </div>
                <div class="footer-col">
                    <h4 class="footer-col__title">Hỗ trợ khách hàng</h4>
                    <ul class="footer-col__list">
                        <li><a href="#">Trung tâm trợ giúp</a></li>
                        <li><a href="#">An toàn mua bán</a></li>
                        <li><a href="#">Liên hệ hỗ trợ</a></li>
                    </ul>
                </div>
                <div class="footer-col">
                    <h4 class="footer-col__title">Về Marketplace</h4>
                    <ul class="footer-col__list">
                        <li><a href="#">Giới thiệu</a></li>
                        <li><a href="#">Chính sách bảo mật</a></li>
                        <li><a href="#">Giải quyết tranh chấp</a></li>
                    </ul>
                </div>
                <div class="footer-col">
                    <h4 class="footer-col__title">Kết nối</h4>
                    <div class="footer-social">
                        <a href="#" aria-label="Facebook"><i class="fab fa-facebook"></i></a>
                        <a href="#" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
                        <a href="#" aria-label="LinkedIn"><i class="fab fa-linkedin"></i></a>
                    </div>
                    <div class="footer-contact">
                        <a href="mailto:support@example.com">support@example.com</a>
                    </div>
                </div>
            </section>

            <div class="footer-bottom">
                <span>© 2025 Marketplace. Mọi quyền được bảo lưu.</span>
                <a href="#">Chính sách sử dụng</a>
            </div>
        </footer>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/toast-notification.js"></script>
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    @* Toast Messages from TempData *@
    @if (TempData["Success"] != null)
    {
        <div data-toast-success="@TempData["Success"]" style="display:none;"></div>
    }
    @if (TempData["Error"] != null)
    {
        <div data-toast-error="@TempData["Error"]" style="display:none;"></div>
    }
    @if (TempData["Warning"] != null)
    {
        <div data-toast-warning="@TempData["Warning"]" style="display:none;"></div>
    }
    @if (TempData["Info"] != null)
    {
        <div data-toast-info="@TempData["Info"]" style="display:none;"></div>
    }

    <button id="scrollToTop" class="scroll-to-top" style="display: none;">
        <i class="fas fa-arrow-up"></i>
    </button>

    <script>
        window.addEventListener('scroll', function() {
            const scrollBtn = document.getElementById('scrollToTop');
            scrollBtn.style.display = window.pageYOffset > 300 ? 'flex' : 'none';
        });

        document.getElementById('scrollToTop')?.addEventListener('click', function() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });

        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                const href = this.getAttribute('href');
                if (href !== '#' && document.querySelector(href)) {
                    e.preventDefault();
                    document.querySelector(href).scrollIntoView({ behavior: 'smooth' });
                }
            });
        });
    </script>
</body>
</html>
