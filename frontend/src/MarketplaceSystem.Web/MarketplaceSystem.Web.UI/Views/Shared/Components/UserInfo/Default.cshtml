@model MarketplaceSystem.Web.UI.Models.ViewModels.User.UserInfoViewModel

@if (Model != null)
{
    <div class="user-menu">
        <div class="user-menu__trigger">
            <img src="@(string.IsNullOrEmpty(Model.Avatar) ? "https://uxwing.com/wp-content/themes/uxwing/download/peoples-avatars/no-profile-picture-icon.png" : Model.Avatar)" alt="@Model.FullName" class="avatar" />
            <span class="user-name">@Model.FullName</span>
            <i class="fas fa-chevron-down"></i>
        </div>
        <div class="user-menu__dropdown">
            <a class="user-menu__item" href="/Account/Profile"><i class="fas fa-user-circle"></i>Hồ sơ cá nhân</a>
            <a class="user-menu__item" href="/Chat"><i class="fas fa-comments"></i>Tin nhắn</a>
            <a class="user-menu__item" href="/Post/MyPosts"><i class="fas fa-clipboard-list"></i>Quản lí tin</a>
            <a class="user-menu__item" href="/Post/FavoritePosts"><i class="fas fa-heart"></i>Tin đã thích</a>
            <div class="user-menu__divider"></div>
                <div class="user-menu__item theme-toggle">
                    <div class="theme-toggle__label">
                        <i class="fas fa-moon"></i>
                        <span>Giao diện tối</span>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" id="darkModeToggle">
                        <span class="toggle-slider"></span>
                    </label>
                </div>
                <div class="user-menu__divider"></div>
            <a class="user-menu__item" href="/Account/WatchHistory"><i class="far fa-clock"></i>Lịch sử xem tin</a>
            <a class="user-menu__item" href="/Account/Transactions"><i class="fas fa-exchange-alt"></i>Lịch sử giao dịch</a>
            <div class="user-menu__divider"></div>
            <a class="user-menu__item" href="/Account/Settings"><i class="fas fa-cog"></i>Cài đặt tài khoản</a>
            <a class="user-menu__item" href="/Support"><i class="far fa-life-ring"></i>Trợ giúp</a>
            <a class="user-menu__item" href="/Feedback"><i class="far fa-comment-dots"></i>Đóng góp ý kiến</a>
            <div class="user-menu__divider"></div>
            <a class="user-menu__item user-menu__logout" href="#" onclick="logoutAsync(event)"><i class="fas fa-sign-out-alt"></i>Đăng xuất</a>
        </div>
    </div>
    <script>
        async function logoutAsync(e){
            e.preventDefault();
            try {
                const res = await fetch('/Auth/LogoutAjax', { method: 'POST', headers: { 'X-Requested-With':'XMLHttpRequest' } });
                const data = await res.json();
                if (data?.success) {
                    window.location.href = '/';
                } else {
                    window.location.href = '/Auth/Login';
                }
            } catch {
                window.location.href = '/Auth/Login';
            }
        }
    </script>
}
else
{
    <a href="/Auth/Login" class="login-btn">
        <i class="fas fa-sign-in-alt"></i>
        Đăng nhập
    </a>
}
