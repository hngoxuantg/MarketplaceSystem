@{
    ViewData["Title"] = "Điều khoản dịch vụ";
}

<div class="policy-hero">
    <div class="container">
        <h1 class="policy-title">ĐIỀU KHOẢN DỊCH VỤ</h1>
        <div class="policy-meta">Cập nhật lần cuối: @DateTime.UtcNow.ToString("dd/MM/yyyy")</div>
    </div>

    <div class="container policy-container">
        <div class="policy-content">
            <aside class="policy-sidebar">
                <div class="policy-toc-title">Mục lục</div>
                <ul class="policy-toc">
                    <li><a href="#t1">1. Chấp nhận điều khoản</a></li>
                    <li><a href="#t2">2. Tài khoản và bảo mật</a></li>
                    <li><a href="#t3">3. Quy tắc đăng tin</a></li>
                    <li><a href="#t4">4. Quyền sở hữu nội dung</a></li>
                    <li><a href="#t5">5. Giới hạn trách nhiệm</a></li>
                    <li><a href="#t6">6. Chấm dứt dịch vụ</a></li>
                </ul>
            </aside>

            <div class="policy-body">
                <section id="t1" class="policy-section">
                    <h2>1. Chấp nhận điều khoản</h2>
                    <p class="policy-lead">Bằng việc đăng ký và sử dụng nền tảng, bạn đồng ý với các điều khoản sau.</p>
                </section>

                <section id="t2" class="policy-section">
                    <h2>2. Tài khoản và bảo mật</h2>
                    <ul>
                        <li>Chịu trách nhiệm bảo mật thông tin đăng nhập.</li>
                        <li>Không mạo danh, giả mạo hoặc sử dụng tài khoản của người khác.</li>
                        <li>Thông báo ngay khi phát hiện truy cập trái phép.</li>
                    </ul>
                </section>

                <section id="t3" class="policy-section">
                    <h2>3. Quy tắc đăng tin</h2>
                    <ul>
                        <li>Không đăng nội dung vi phạm pháp luật, lừa đảo, phản cảm.</li>
                        <li>Thông tin sản phẩm phải chính xác, minh bạch về giá và tình trạng.</li>
                        <li>Chúng tôi có quyền gỡ nội dung vi phạm mà không cần báo trước.</li>
                    </ul>
                </section>

                <section id="t4" class="policy-section">
                    <h2>4. Quyền sở hữu nội dung</h2>
                    <p>Bạn giữ quyền sở hữu nội dung do mình tạo; khi đăng tải, bạn cấp cho chúng tôi quyền sử dụng nội dung để vận hành và quảng bá dịch vụ.</p>
                </section>

                <section id="t5" class="policy-section">
                    <h2>5. Giới hạn trách nhiệm</h2>
                    <p>Chúng tôi không chịu trách nhiệm cho các giao dịch giữa người mua và người bán; nền tảng chỉ đóng vai trò trung gian.</p>
                </section>

                <section id="t6" class="policy-section">
                    <h2>6. Chấm dứt dịch vụ</h2>
                    <p>Chúng tôi có thể tạm ngưng hoặc chấm dứt quyền truy cập của bạn nếu có dấu hiệu vi phạm điều khoản.</p>
                </section>
            </div>
        </div>

        <div class="policy-footer">
            <span>Bằng việc tiếp tục sử dụng, bạn đồng ý tuân thủ các điều khoản trên.</span>
            <div class="policy-actions">
                <a class="policy-btn" href="/">Về trang chủ</a>
                <a class="policy-btn" href="/Auth/Register">Quay lại đăng ký</a>
            </div>
        </div>
    </div>
</div>


