@model MarketplaceSystem.Web.UI.Admin.Models.ViewModel.Categories.CategoryViewModel

@{
    ViewData["Title"] = "Chi tiết danh mục";
}

<div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom">
    <h1 class="h2"><i class="fas fa-info-circle"></i> Chi tiết danh mục</h1>
    <div class="btn-group">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="fas fa-edit"></i> Chỉnh sửa
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Quay lại
        </a>
        <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
            <i class="fas fa-trash"></i> Xóa
        </button>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <!-- Thông tin cơ bản -->
    <div class="col-lg-8 mb-4">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="fas fa-info"></i> Thông tin cơ bản</h5>
            </div>
            <div class="card-body">
                <table class="table table-borderless">
                    <tbody>
                        <tr>
                            <td class="fw-bold" style="width: 200px;">ID:</td>
                            <td>#@Model.Id</td>
                        </tr>
                        <tr>
                            <td class="fw-bold">Tên danh mục:</td>
                            <td class="fs-5">@Model.Name</td>
                        </tr>
                        <tr>
                            <td class="fw-bold">Mô tả:</td>
                            <td>@(Model.Description ?? "Không có mô tả")</td>
                        </tr>
                        <tr>
                            <td class="fw-bold">Icon:</td>
                            <td>
                                @if (!string.IsNullOrEmpty(Model.Icon))
                                {
                                    @if (Model.Icon.StartsWith("http"))
                                    {
                                        <img src="@Model.Icon" alt="@Model.Name" class="img-thumbnail" style="width: 80px; height: 80px; object-fit: cover;">
                                        <br />
                                        <small class="text-muted">@Model.Icon</small>
                                    }
                                    else if (Model.Icon.StartsWith("fa-"))
                                    {
                                        <i class="fas @Model.Icon fa-3x text-primary"></i>
                                        <br />
                                        <small class="text-muted">Font Awesome: @Model.Icon</small>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">Không có icon</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <td class="fw-bold">Danh mục cha:</td>
                            <td>
                                @if (Model.IsParentCategory)
                                {
                                    <span class="badge bg-primary">Danh mục gốc</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@Model.ParentCategoryName</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <td class="fw-bold">Thứ tự hiển thị:</td>
                            <td><span class="badge bg-light text-dark fs-6">@Model.DisplayOrder</span></td>
                        </tr>
                        <tr>
                            <td class="fw-bold">Trạng thái:</td>
                            <td>
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success fs-6">
                                        <i class="fas fa-check-circle"></i> Đang hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning fs-6">
                                        <i class="fas fa-pause-circle"></i> Tạm dừng
                                    </span>
                                }
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Sidebar -->
    <div class="col-lg-4 mb-4">
        <!-- Thống kê -->
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-info text-white">
                <h6 class="mb-0"><i class="fas fa-chart-bar"></i> Thống kê</h6>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <small class="text-muted">Danh mục con</small>
                        <div class="fs-4 fw-bold text-primary">@Model.SubCategoriesCount</div>
                    </div>
                    <i class="fas fa-layer-group fa-2x text-muted"></i>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted">Thuộc tính</small>
                        <div class="fs-4 fw-bold text-success">@(Model.Attributes?.Count ?? 0)</div>
                    </div>
                    <i class="fas fa-tags fa-2x text-muted"></i>
                </div>
            </div>
        </div>

        <!-- Thời gian -->
        <div class="card shadow-sm">
            <div class="card-header bg-secondary text-white">
                <h6 class="mb-0"><i class="fas fa-clock"></i> Thời gian</h6>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <small class="text-muted d-block">Ngày tạo</small>
                    <div class="fw-bold">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
                @if (Model.UpdatedAt.HasValue)
                {
                    <div>
                        <small class="text-muted d-block">Cập nhật lần cuối</small>
                        <div class="fw-bold">@Model.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                }
                else
                {
                    <div class="text-muted">Chưa có cập nhật</div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Danh mục con -->
@if (Model.HasSubCategories && Model.SubCategories != null)
{
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0"><i class="fas fa-sitemap"></i> Danh mục con (@Model.SubCategoriesCount)</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Tên danh mục</th>
                            <th>Thứ tứ</th>
                            <th>Trạng thái</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sub in Model.SubCategories.OrderBy(s => s.DisplayOrder))
                        {
                            <tr>
                                <td>#@sub.Id</td>
                                <td>
                                    <strong>@sub.Name</strong>
                                    @if (!string.IsNullOrEmpty(sub.Description))
                                    {
                                        <br />
                                        <small class="text-muted">@sub.Description</small>
                                    }
                                </td>
                                <td><span class="badge bg-light text-dark">@sub.DisplayOrder</span></td>
                                <td>
                                    @if (sub.IsActive)
                                    {
                                        <span class="badge bg-success">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">Tạm dừng</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-action="Details" asp-route-id="@sub.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@sub.Id" class="btn btn-sm btn-outline-secondary">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- Thuộc tính danh mục -->
@if (Model.Attributes != null && Model.Attributes.Any())
{
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0"><i class="fas fa-list-alt"></i> Thuộc tính danh mục (@Model.Attributes.Count)</h5>
        </div>
        <div class="card-body">
            @await Html.PartialAsync("_CategoryAttributesPartial", Model.Attributes)
        </div>
    </div>
}
else
{
    <div class="card shadow-sm mb-4">
        <div class="card-body text-center py-5">
            <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
            <p class="text-muted">Danh mục này chưa có thuộc tính nào</p>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="fas fa-plus"></i> Thêm thuộc tính
            </a>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="fas fa-exclamation-triangle"></i> Xác nhận xóa danh mục
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">
                    Bạn có chắc chắn muốn xóa danh mục <strong>"@Model.Name"</strong>?
                </p>
                <p class="text-danger mt-2 mb-0">
                    <i class="fas fa-warning"></i> <strong>Lưu ý:</strong> Hành động này không thể hoàn tác!
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <form method="post" asp-action="Delete" asp-route-id="@Model.Id" style="display: inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash"></i> Xóa danh mục
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/admin/category-details.css" />
}
