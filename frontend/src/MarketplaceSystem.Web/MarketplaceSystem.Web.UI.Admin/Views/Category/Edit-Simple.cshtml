@model MarketplaceSystem.Web.UI.Admin.Models.ViewModel.Categories.CategoryViewModel

@{
    ViewData["Title"] = "Chỉnh sửa danh mục";
    var parentCategories = ViewBag.ParentCategories as List<MarketplaceSystem.Web.UI.Admin.Models.ViewModel.Categories.CategoryViewModel> ?? new List<MarketplaceSystem.Web.UI.Admin.Models.ViewModel.Categories.CategoryViewModel>();
    var isParentCategory = Model.HasSubCategories || (Model.SubCategories != null && Model.SubCategories.Any());
}

<div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom">
    <h1 class="h2"><i class="fas fa-edit"></i> Chỉnh sửa danh mục</h1>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Quay lại
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <!-- Thông tin cơ bản -->
    <div class="col-lg-8 mb-4">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="fas fa-info"></i> Thông tin cơ bản</h5>
            </div>
            <div class="card-body">
                <form method="post" asp-action="UpdateCategory" asp-route-id="@Model.Id">
                    @Html.AntiForgeryToken()
                    
                    <div class="row mb-3">
                        <div class="col-md-8">
                            <label class="form-label">Tên danh mục <span class="text-danger">*</span></label>
                            <input type="text" name="Name" class="form-control" value="@Model.Name" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Thứ tự</label>
                            <input type="number" name="DisplayOrder" class="form-control" value="@Model.DisplayOrder" min="1" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Mô tả</label>
                        <textarea name="Description" class="form-control" rows="3">@Model.Description</textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Danh mục cha</label>
                        <select name="ParentCategoryId" class="form-select">
                            <option value="">-- Danh mục gốc --</option>
                            @foreach (var cat in parentCategories)
                            {
                                <option value="@cat.Id" selected="@(Model.ParentCategoryId == cat.Id)">@cat.Name</option>
                            }
                        </select>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input type="checkbox" name="IsActive" class="form-check-input" value="true" checked="@Model.IsActive" />
                        <label class="form-check-label">Kích hoạt danh mục</label>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Cập nhật thông tin cơ bản
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Sidebar -->
    <div class="col-lg-4 mb-4">
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-info text-white">
                <h6 class="mb-0"><i class="fas fa-info-circle"></i> Thông tin</h6>
            </div>
            <div class="card-body">
                <p class="mb-2"><strong>ID:</strong> #@Model.Id</p>
                <p class="mb-2"><strong>Ngày tạo:</strong> @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                @if (Model.UpdatedAt.HasValue)
                {
                    <p class="mb-0"><strong>Cập nhật:</strong> @Model.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm")</p>
                }
            </div>
        </div>

        @if (isParentCategory)
        {
            <div class="alert alert-warning">
                <i class="fas fa-exclamation-triangle"></i>
                <strong>Lưu ý:</strong> Danh mục này có danh mục con, không thể thêm thuộc tính.
            </div>
        }
    </div>
</div>

@if (!isParentCategory)
{
    <!-- Quản lý thuộc tính -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="fas fa-list-alt"></i> Thuộc tính danh mục</h5>
            <button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#addAttributeModal">
                <i class="fas fa-plus"></i> Thêm thuộc tính mới
            </button>
        </div>
        <div class="card-body">
            @if (Model.Attributes != null && Model.Attributes.Any())
            {
                @foreach (var attr in Model.Attributes)
                {
                    <div class="card mb-3">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <h6 class="mb-0">
                                <span class="badge bg-primary">@attr.DisplayOrder</span>
                                @attr.DisplayName
                                <small class="text-muted">(@attr.AttributeType.Name)</small>
                            </h6>
                            <form method="post" asp-action="DeleteAttribute" asp-route-categoryId="@Model.Id" asp-route-attributeId="@attr.Id" style="display: inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa thuộc tính này?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger">
                                    <i class="fas fa-trash"></i> Xóa
                                </button>
                            </form>
                        </div>
                        <div class="card-body">
                            <form method="post" asp-action="UpdateAttribute" asp-route-categoryId="@Model.Id" asp-route-attributeId="@attr.Id">
                                @Html.AntiForgeryToken()
                                
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Tên thuộc tính (Name)</label>
                                        <input type="text" name="Name" class="form-control" value="@attr.Name" readonly />
                                        <small class="text-muted">Không thể thay đổi</small>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Tên hiển thị <span class="text-danger">*</span></label>
                                        <input type="text" name="DisplayName" class="form-control" value="@attr.DisplayName" required />
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-md-4">
                                        <label class="form-label">Thứ tự</label>
                                        <input type="number" name="DisplayOrder" class="form-control" value="@attr.DisplayOrder" min="1" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Placeholder</label>
                                        <input type="text" name="Placeholder" class="form-control" value="@attr.Placeholder" />
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-check mt-4">
                                            <input type="checkbox" name="IsRequired" class="form-check-input" value="true" checked="@attr.IsRequired" />
                                            <label class="form-check-label">Bắt buộc</label>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-grid">
                                    <button type="submit" class="btn btn-outline-primary">
                                        <i class="fas fa-save"></i> Cập nhật thuộc tính
                                    </button>
                                </div>
                            </form>

                            @if (attr.AttributeType.Name == "Select" || attr.AttributeType.Name == "MultiSelect")
                            {
                                <hr class="my-3" />
                                <h6><i class="fas fa-list-ul"></i> Tùy chọn (Options)</h6>
                                
                                @if (attr.Options != null && attr.Options.Any())
                                {
                                    @foreach (var option in attr.Options)
                                    {
                                        <div class="card mb-2">
                                            <div class="card-body p-3">
                                                <form method="post" asp-action="UpdateAttributeOption" 
                                                      asp-route-categoryId="@Model.Id" 
                                                      asp-route-attributeId="@attr.Id" 
                                                      asp-route-optionId="@option.Id">
                                                    @Html.AntiForgeryToken()
                                                    
                                                    <input type="hidden" name="Id" value="@option.Id" />
                                                    <input type="hidden" name="CategoryAttributeId" value="@attr.Id" />
                                                    
                                                    <div class="row align-items-end mb-2">
                                                        <div class="col-md-4">
                                                            <label class="form-label small">Giá trị (Value)</label>
                                                            <input type="text" name="Value" class="form-control form-control-sm" value="@option.Value" required />
                                                        </div>
                                                        <div class="col-md-4">
                                                            <label class="form-label small">Tên hiển thị</label>
                                                            <input type="text" name="DisplayText" class="form-control form-control-sm" value="@option.DisplayText" required />
                                                        </div>
                                                        <div class="col-md-2">
                                                            <div class="form-check form-switch">
                                                                <input type="checkbox" name="IsActive" class="form-check-input" value="true" checked="@option.IsActive" />
                                                                <label class="form-check-label small">Active</label>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-2">
                                                            <button type="submit" class="btn btn-sm btn-success w-100">
                                                                <i class="fas fa-save"></i>
                                                            </button>
                                                        </div>
                                                    </div>
                                                </form>
                                                
                                                <form method="post" asp-action="DeleteAttributeOption" 
                                                      asp-route-categoryId="@Model.Id" 
                                                      asp-route-attributeId="@attr.Id" 
                                                      asp-route-optionId="@option.Id"
                                                      onsubmit="return confirm('Xóa option này?')"
                                                      style="display: inline;">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                                                        <i class="fas fa-trash"></i> Xóa option
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p class="text-muted">Chưa có option nào.</p>
                                }
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center text-muted py-4">
                    <i class="fas fa-inbox fa-3x mb-3"></i>
                    <p>Chưa có thuộc tính nào. Click "Thêm thuộc tính mới" để bắt đầu.</p>
                </div>
            }
        </div>
    </div>
}

<!-- Add Attribute Modal -->
<div class="modal fade" id="addAttributeModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-action="CreateAttribute" asp-route-categoryId="@Model.Id">
                @Html.AntiForgeryToken()
                
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-plus"></i> Thêm thuộc tính mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Tên thuộc tính (Name) <span class="text-danger">*</span></label>
                            <input type="text" name="Name" class="form-control" placeholder="VD: brand" required />
                            <small class="text-muted">Viết thường, không dấu</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Tên hiển thị <span class="text-danger">*</span></label>
                            <input type="text" name="DisplayName" class="form-control" placeholder="VD: Thương hiệu" required />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Loại thuộc tính <span class="text-danger">*</span></label>
                            <select name="AttributeType" class="form-select" required id="attrTypeSelect">
                                <option value="">-- Chọn loại --</option>
                                <option value="Text">Text</option>
                                <option value="Number">Number</option>
                                <option value="Select">Select</option>
                                <option value="MultiSelect">Multi Select</option>
                                <option value="Boolean">Boolean</option>
                                <option value="Date">Date</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Thứ tự</label>
                            <input type="number" name="DisplayOrder" class="form-control" value="1" min="1" />
                        </div>
                        <div class="col-md-4">
                            <div class="form-check mt-4">
                                <input type="checkbox" name="IsRequired" class="form-check-input" value="true" />
                                <label class="form-check-label">Bắt buộc</label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Placeholder</label>
                        <input type="text" name="Placeholder" class="form-control" placeholder="VD: Nhập thương hiệu..." />
                    </div>

                    <div id="optionsSection" style="display: none;">
                        <hr />
                        <label class="form-label">Tùy chọn (Options)</label>
                        <div id="optionsList"></div>
                        <button type="button" class="btn btn-sm btn-secondary" onclick="addOptionRow()">
                            <i class="fas fa-plus"></i> Thêm option
                        </button>
                    </div>
                </div>
                
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Lưu thuộc tính
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/admin/category-edit.css" />
}

@section Scripts {
    <script>
        // Show/hide options section based on attribute type
        document.getElementById('attrTypeSelect')?.addEventListener('change', function() {
            const optionsSection = document.getElementById('optionsSection');
            if (this.value === 'Select' || this.value === 'MultiSelect') {
                optionsSection.style.display = 'block';
                // Add first option row if empty
                if (document.getElementById('optionsList').children.length === 0) {
                    addOptionRow();
                }
            } else {
                optionsSection.style.display = 'none';
            }
        });

        let optionIndex = 0;
        function addOptionRow() {
            const html = `
                <div class="input-group mb-2">
                    <input type="text" name="AttributeOptions[${optionIndex}].Value" class="form-control" placeholder="Giá trị" required />
                    <input type="text" name="AttributeOptions[${optionIndex}].DisplayText" class="form-control" placeholder="Tên hiển thị" required />
                    <button type="button" class="btn btn-outline-danger" onclick="this.parentElement.remove()">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            `;
            document.getElementById('optionsList').insertAdjacentHTML('beforeend', html);
            optionIndex++;
        }
    </script>
}
