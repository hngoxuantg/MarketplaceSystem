@model List<MarketplaceSystem.Web.UI.Admin.Models.ViewModel.Categories.CategoryAttributeViewModel>

<div class="attributes-list">
    @foreach (var attr in Model.OrderBy(a => a.DisplayOrder))
    {
        <div class="card mb-3">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <div class="d-flex align-items-center">
                            <span class="badge bg-primary me-2">@attr.DisplayOrder</span>
                            <div>
                                <h6 class="mb-1">
                                    @attr.DisplayName
                                    @if (attr.IsRequired)
                                    {
                                        <span class="badge bg-danger ms-2">Required</span>
                                    }
                                </h6>
                                <small class="text-muted">
                                    <i class="fas fa-code"></i> @attr.Name
                                </small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <small class="text-muted d-block">Loại thuộc tính</small>
                        <span class="badge bg-info">
                            @switch (attr.AttributeType.Name)
                            {
                                case "Text":
                                    <i class="fas fa-font"></i>
                                    break;
                                case "Number":
                                    <i class="fas fa-hashtag"></i>
                                    break;
                                case "Select":
                                    <i class="fas fa-list"></i>
                                    break;
                                case "Boolean":
                                    <i class="fas fa-toggle-on"></i>
                                    break;
                                case "Date":
                                    <i class="fas fa-calendar"></i>
                                    break;
                                default:
                                    <i class="fas fa-question"></i>
                                    break;
                            }
                            @attr.AttributeType.Name
                        </span>
                    </div>
                    <div class="col-md-3">
                        @if (!string.IsNullOrEmpty(attr.Placeholder))
                        {
                            <small class="text-muted d-block">Placeholder</small>
                            <small><i class="fas fa-info-circle"></i> @attr.Placeholder</small>
                        }
                    </div>
                </div>

                @* Hiển thị options nếu là Select *@
                @if (attr.AttributeType.Name == "Select" && attr.Options != null && attr.Options.Any())
                {
                    <div class="mt-3 pt-3 border-top">
                        <small class="text-muted d-block mb-2">
                            <i class="fas fa-list-ul"></i> Tùy chọn (@attr.Options.Count)
                        </small>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var option in attr.Options)
                            {
                                <span class="badge @(option.IsActive ? "bg-success" : "bg-secondary")">
                                    @option.DisplayText
                                    @if (!option.IsActive)
                                    {
                                        <i class="fas fa-ban ms-1"></i>
                                    }
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<style>
    .attributes-list .card {
        transition: transform 0.2s;
    }

    .attributes-list .card:hover {
        transform: translateX(5px);
        box-shadow: 0 0.125rem 0.5rem rgba(0, 0, 0, 0.1);
    }
</style>
