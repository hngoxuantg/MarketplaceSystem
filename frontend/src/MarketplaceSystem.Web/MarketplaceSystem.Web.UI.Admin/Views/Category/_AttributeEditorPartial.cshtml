@model MarketplaceSystem.Web.UI.Admin.Models.ViewModel.Categories.CategoryAttributeViewModel

@{
    var index = ViewData["Index"] as int? ?? 0;
    var prefix = $"Attributes[{index}]";
    var selectedType = Model.AttributeType?.Id ?? 0;
}

<div class="attribute-item card mb-3" data-index="@index">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <h6 class="mb-0">
                <span class="badge bg-primary">@Model.DisplayOrder</span>
                Thu?c tính #@(index + 1)
            </h6>
            <button type="button" class="btn btn-sm btn-outline-danger btn-remove-attribute">
                <i class="fas fa-trash"></i>
            </button>
        </div>

        <input type="hidden" name="@(prefix).Id" value="@Model.Id" />
        <input type="hidden" name="@(prefix).CategoryId" value="@Model.CategoryId" />

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Tên (key) <span class="text-danger">*</span></label>
                <input type="text" name="@(prefix).Name" value="@Model.Name" 
                       class="form-control" placeholder="VD: brand" required />
                <small class="text-muted">Dùng trong code, không d?u, lowercase</small>
            </div>

            <div class="col-md-4 mb-3">
                <label class="form-label">Tên hi?n th? <span class="text-danger">*</span></label>
                <input type="text" name="@(prefix).DisplayName" value="@Model.DisplayName" 
                       class="form-control" placeholder="VD: Hãng xe" required />
            </div>

            <div class="col-md-2 mb-3">
                <label class="form-label">Th? t?</label>
                <input type="number" name="@(prefix).DisplayOrder" value="@Model.DisplayOrder" 
                       class="form-control" min="1" />
            </div>

            <div class="col-md-2 mb-3">
                <label class="form-label">B?t bu?c</label>
                <div class="form-check form-switch mt-2">
                    <input type="checkbox" name="@(prefix).IsRequired" value="true" 
                           checked="@Model.IsRequired" class="form-check-input" />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Lo?i d? li?u <span class="text-danger">*</span></label>
                <select name="@(prefix).AttributeType.Id" class="form-select attribute-type-select" required>
                    <option value="">-- Ch?n lo?i --</option>
                    <option value="1" selected="@(selectedType == 1)">Text - V?n b?n</option>
                    <option value="2" selected="@(selectedType == 2)">Number - S?</option>
                    <option value="3" selected="@(selectedType == 3)">Select - L?a ch?n</option>
                    <option value="4" selected="@(selectedType == 4)">MultiSelect - Nhi?u l?a ch?n</option>
                    <option value="5" selected="@(selectedType == 5)">Boolean - Có/Không</option>
                    <option value="6" selected="@(selectedType == 6)">Date - Ngày tháng</option>
                </select>
            </div>

            <div class="col-md-8 mb-3">
                <label class="form-label">Placeholder</label>
                <input type="text" name="@(prefix).Placeholder" value="@Model.Placeholder" 
                       class="form-control" placeholder="VD: Nh?p hãng xe..." />
            </div>
        </div>

        @* Options cho Select/MultiSelect *@
        <div class="options-container" style="display: @(selectedType == 3 || selectedType == 4 ? "block" : "none")">
            <div class="border-top pt-3 mt-2">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <label class="form-label mb-0">
                        <i class="fas fa-list-ul"></i> Tùy ch?n
                    </label>
                    <button type="button" class="btn btn-sm btn-outline-success btn-add-option">
                        <i class="fas fa-plus"></i> Thêm option
                    </button>
                </div>

                <div class="options-list">
                    @if (Model.Options != null && Model.Options.Any())
                    {
                        @for (int j = 0; j < Model.Options.Count; j++)
                        {
                            var option = Model.Options[j];
                            var optPrefix = $"{prefix}.Options[{j}]";
                            <div class="option-item input-group mb-2">
                                <input type="hidden" name="@(optPrefix).Id" value="@option.Id" />
                                <input type="text" name="@(optPrefix).Value" value="@option.Value" 
                                       class="form-control" placeholder="Value (key)" required />
                                <input type="text" name="@(optPrefix).DisplayText" value="@option.DisplayText" 
                                       class="form-control" placeholder="Display Text" required />
                                <div class="input-group-text">
                                    <input type="checkbox" name="@(optPrefix).IsActive" value="true" 
                                           checked="@option.IsActive" class="form-check-input" />
                                    <label class="ms-2 mb-0">Active</label>
                                </div>
                                <button type="button" class="btn btn-outline-danger btn-remove-option">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>
