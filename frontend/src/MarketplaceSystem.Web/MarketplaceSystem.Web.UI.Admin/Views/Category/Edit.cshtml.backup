@model MarketplaceSystem.Web.UI.Admin.Models.ViewModel.Categories.CategoryViewModel

@{
    ViewData["Title"] = "Chỉnh sửa danh mục";
    var parentCategories = ViewBag.ParentCategories as List<MarketplaceSystem.Web.UI.Admin.Models.ViewModel.Categories.CategoryViewModel> ?? new List<MarketplaceSystem.Web.UI.Admin.Models.ViewModel.Categories.CategoryViewModel>();
    var isParentCategory = Model.HasSubCategories || (Model.SubCategories != null && Model.SubCategories.Any());
}

<div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom">
    <h1 class="h2"><i class="fas fa-edit"></i> Chỉnh sửa danh mục</h1>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Quay lại
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <!-- Thông tin cơ bản -->
    <div class="col-lg-8 mb-4">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="fas fa-info"></i> Thông tin cơ bản</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-8">
                        <label class="form-label">Tên danh mục <span class="text-danger">*</span></label>
                        <input type="text" id="categoryName" class="form-control" value="@Model.Name" placeholder="VD: Điện thoại" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Thứ tự</label>
                        <input type="number" id="categoryDisplayOrder" class="form-control" value="@Model.DisplayOrder" min="1" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Mô tả</label>
                    <textarea id="categoryDescription" class="form-control" rows="3" placeholder="Mô tả ngắn về danh mục">@Model.Description</textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">Danh mục cha</label>
                    <select id="categoryParentId" class="form-select">
                        <option value="">-- Danh mục gốc --</option>
                        @foreach (var cat in parentCategories)
                        {
                            if (Model.ParentCategoryId == cat.Id)
                            {
                                <option value="@cat.Id" selected>@cat.Name</option>
                            }
                            else
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        }
                    </select>
                    <small class="text-muted">Bỏ trống nếu đây là danh mục gốc</small>
                </div>

                <div class="form-check form-switch mb-3">
                    <input type="checkbox" id="categoryIsActive" class="form-check-input" @(Model.IsActive ? "checked" : "") />
                    <label class="form-check-label">Kích hoạt danh mục</label>
                </div>

                <div class="d-grid">
                    <button type="button" class="btn btn-primary" id="btnUpdateCategory">
                        <i class="fas fa-save"></i> Cập nhật thông tin cơ bản
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Sidebar -->
    <div class="col-lg-4 mb-4">
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-info text-white">
                <h6 class="mb-0"><i class="fas fa-info-circle"></i> Thông tin</h6>
            </div>
            <div class="card-body">
                <p class="mb-2"><strong>ID:</strong> #@Model.Id</p>
                <p class="mb-2"><strong>Ngày tạo:</strong> @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                @if (Model.UpdatedAt.HasValue)
                {
                    <p class="mb-0"><strong>Cập nhật:</strong> @Model.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm")</p>
                }
            </div>
        </div>

        @if (isParentCategory)
        {
            <div class="alert alert-warning">
                <i class="fas fa-exclamation-triangle"></i>
                <strong>Lưu ý:</strong> Danh mục này có danh mục con, không thể thêm thuộc tính.
            </div>
        }
    </div>
</div>

@if (!isParentCategory)
{
    <!-- Quản lý thuộc tính -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="fas fa-list-alt"></i> Thuộc tính danh mục</h5>
            <button type="button" class="btn btn-sm btn-success" id="btnAddAttribute">
                <i class="fas fa-plus"></i> Thêm thuộc tính mới
            </button>
        </div>
        <div class="card-body">
            <div id="attributesContainer">
                @if (Model.Attributes != null && Model.Attributes.Any())
                {
                    @foreach (var attr in Model.Attributes)
                    {
                        <div class="card mb-3 attribute-item" data-attribute-id="@attr.Id">
                            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                                <h6 class="mb-0">
                                    <span class="badge bg-primary">@attr.DisplayOrder</span>
                                    @attr.DisplayName
                                </h6>
                                <button type="button" class="btn btn-sm btn-danger btn-delete-attribute" 
                                        data-category-id="@Model.Id" data-attribute-id="@attr.Id">
                                    <i class="fas fa-trash"></i> Xóa
                                </button>
                            </div>
                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Tên thuộc tính (Name)</label>
                                        <input type="text" class="form-control attr-name" value="@attr.Name" readonly />
                                        <small class="text-muted">Không thể thay đổi</small>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Tên hiển thị</label>
                                        <input type="text" class="form-control attr-display-name" value="@attr.DisplayName" />
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-md-4">
                                        <label class="form-label">Loại</label>
                                        <input type="text" class="form-control" value="@attr.AttributeType.Name" readonly />
                                        <small class="text-muted">Không thể thay đổi loại</small>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Thứ tự</label>
                                        <input type="number" class="form-control attr-display-order" value="@attr.DisplayOrder" min="1" />
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-check mt-4">
                                            <input type="checkbox" class="form-check-input attr-is-required" 
                                                   @(attr.IsRequired ? "checked" : "") />
                                            <label class="form-check-label">Bắt buộc</label>
                                        </div>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Placeholder</label>
                                    <input type="text" class="form-control attr-placeholder" value="@attr.Placeholder" />
                                </div>

                                <div class="d-grid mb-3">
                                    <button type="button" class="btn btn-outline-primary btn-update-attribute" 
                                            data-category-id="@Model.Id" data-attribute-id="@attr.Id">
                                        <i class="fas fa-save"></i> Cập nhật thuộc tính này
                                    </button>
                                </div>

                                @if (attr.AttributeType.Name == "Select" || attr.AttributeType.Name == "MultiSelect")
                                {
                                    <hr />
                                    <div class="options-section">
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <h6 class="mb-0"><i class="fas fa-list-ul"></i> Tùy chọn (Options)</h6>
                                        </div>
                                        @if (attr.Options != null && attr.Options.Any())
                                        {
                                            @foreach (var option in attr.Options)
                                            {
                                                <div class="card mb-2 option-item" data-option-id="@option.Id">
                                                    <div class="card-body p-3">
                                                        <div class="row align-items-center mb-2">
                                                            <div class="col-md-4">
                                                                <label class="form-label mb-1 small">Giá trị (Value)</label>
                                                                <input type="text" class="form-control form-control-sm opt-value" 
                                                                       value="@option.Value" />
                                                            </div>
                                                            <div class="col-md-4">
                                                                <label class="form-label mb-1 small">Tên hiển thị</label>
                                                                <input type="text" class="form-control form-control-sm opt-display-text" 
                                                                       value="@option.DisplayText" />
                                                            </div>
                                                            <div class="col-md-2">
                                                                <label class="form-label mb-1 small">Kích hoạt</label>
                                                                <div class="form-check form-switch">
                                                                    <input type="checkbox" class="form-check-input opt-is-active" 
                                                                           @(option.IsActive ? "checked" : "") />
                                                                </div>
                                                            </div>
                                                            <div class="col-md-2 text-end">
                                                                <label class="form-label mb-1 small">&nbsp;</label>
                                                                <button type="button" class="btn btn-sm btn-danger btn-delete-option d-block" 
                                                                        data-category-id="@Model.Id" 
                                                                        data-attribute-id="@attr.Id" 
                                                                        data-option-id="@option.Id">
                                                                    <i class="fas fa-trash"></i>
                                                                </button>
                                                            </div>
                                                        </div>
                                                        <div class="d-grid">
                                                            <button type="button" class="btn btn-sm btn-outline-success btn-update-option" 
                                                                    data-category-id="@Model.Id" 
                                                                    data-attribute-id="@attr.Id" 
                                                                    data-option-id="@option.Id">
                                                                <i class="fas fa-save"></i> Cập nhật option này
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <p class="text-muted">Chưa có option nào.</p>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center text-muted py-4" id="emptyMessage">
                        <i class="fas fa-inbox fa-3x mb-3"></i>
                        <p>Chưa có thuộc tính nào. Click "Thêm thuộc tính mới" để bắt đầu.</p>
                    </div>
                }
            </div>
        </div>
    </div>
}

<!-- Add Attribute Modal -->
<div class="modal fade" id="addAttributeModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-plus"></i> Thêm thuộc tính mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Tên thuộc tính (Name) <span class="text-danger">*</span></label>
                        <input type="text" id="newAttrName" class="form-control" placeholder="VD: brand" />
                        <small class="text-muted">Viết thường, không dấu, không khoảng trắng</small>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Tên hiển thị <span class="text-danger">*</span></label>
                        <input type="text" id="newAttrDisplayName" class="form-control" placeholder="VD: Hãng xe" />
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label">Loại thuộc tính <span class="text-danger">*</span></label>
                        <select id="newAttrType" class="form-select">
                            <option value="">-- Chọn loại --</option>
                            <option value="Text">Text</option>
                            <option value="Number">Number</option>
                            <option value="Select">Select</option>
                            <option value="MultiSelect">Multi Select</option>
                            <option value="Boolean">Boolean</option>
                            <option value="Date">Date</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Thứ tự</label>
                        <input type="number" id="newAttrDisplayOrder" class="form-control" value="1" min="1" />
                    </div>
                    <div class="col-md-4">
                        <div class="form-check mt-4">
                            <input type="checkbox" id="newAttrIsRequired" class="form-check-input" />
                            <label class="form-check-label">Bắt buộc</label>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Placeholder</label>
                    <input type="text" id="newAttrPlaceholder" class="form-control" placeholder="VD: Nhập hãng xe..." />
                </div>

                <div id="newAttrOptionsContainer" style="display: none;">
                    <hr />
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label mb-0">Tùy chọn (Options)</label>
                        <button type="button" class="btn btn-sm btn-success" id="btnAddNewOption">
                            <i class="fas fa-plus"></i> Thêm option
                        </button>
                    </div>
                    <div id="newOptionsList"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" id="btnSaveNewAttribute">
                    <i class="fas fa-save"></i> Lưu thuộc tính
                </button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/admin/category-edit.css" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const categoryId = @Model.Id;
        console.log('Category ID:', categoryId);
    </script>
    <script src="~/js/admin/category-edit-simple.js"></script>
}
