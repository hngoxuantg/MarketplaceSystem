@model MarketplaceSystem.Web.UI.Admin.Models.ViewModel.Categories.CategoryIndexViewModel

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th style="width: 60px;">ID</th>
                <th style="width: 80px;">Icon</th>
                <th>Tên danh mục</th>
                <th style="width: 150px;">Danh mục cha</th>
                <th style="width: 120px;" class="text-center">Danh mục con</th>
                <th style="width: 120px;">Trạng thái</th>
                <th style="width: 100px;" class="text-center">Thao tác</th>
                <th style="width: 220px;" class="text-center">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Categories.Data.Any())
            {
                @foreach (var category in Model.Categories.Data)
                {
                    <tr>
                        <td><strong>#@category.Id</strong></td>
                        <td class="text-center">
                            @if (!string.IsNullOrEmpty(category.Icon))
                            {
                                @if (category.Icon.StartsWith("http"))
                                {
                                    <img src="@category.Icon" alt="@category.Name" 
                                         class="category-icon-img" style="width: 40px; height: 40px; object-fit: cover; border-radius: 4px;">
                                }
                                else if (category.Icon.StartsWith("fa-"))
                                {
                                    <i class="fas @category.Icon fa-2x text-primary"></i>
                                }
                                else
                                {
                                    <i class="fas fa-folder fa-2x text-muted"></i>
                                }
                            }
                            else
                            {
                                <i class="fas fa-folder fa-2x text-muted"></i>
                            }
                        </td>
                        <td>
                            <div class="fw-bold">@category.Name</div>
                            @if (!string.IsNullOrEmpty(category.Description))
                            {
                                <small class="text-muted">@category.Description</small>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(category.ParentCategoryName))
                            {
                                <span class="badge bg-secondary">@category.ParentCategoryName</span>
                            }
                            else
                            {
                                <span class="badge bg-primary">Danh mục gốc</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (category.HasSubCategories)
                            {
                                <span class="badge bg-info">@category.SubCategoriesCount</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            @if (category.IsActive)
                            {
                                <span class="badge bg-success">
                                    <i class="fas fa-check-circle"></i> Hoạt động
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning">
                                    <i class="fas fa-pause-circle"></i> Tạm dừng
                                </span>
                            }
                        </td>
                        <td class="text-center">
                            <span class="badge bg-light text-dark">@category.DisplayOrder</span>
                        </td>
                        <td class="text-center">
                            <div class="btn-group btn-group-sm" role="group">
                                <a href="@Url.Action("Details", new { id = category.Id })" 
                                   class="btn btn-outline-info" title="Xem chi tiết">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="@Url.Action("Edit", new { id = category.Id })" 
                                   class="btn btn-outline-primary" title="Chỉnh sửa">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <button class="btn btn-outline-@(category.IsActive ? "warning" : "success")" 
                                        onclick="toggleStatus(@category.Id, @category.IsActive.ToString().ToLower())" 
                                        title="@(category.IsActive ? "Tạm dừng" : "Kích hoạt")">
                                    <i class="fas fa-@(category.IsActive ? "pause" : "play")"></i>
                                </button>
                                <button class="btn btn-outline-danger" onclick="deleteCategory(@category.Id, '@category.Name')" 
                                        title="Xóa">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center py-5">
                        <div class="text-muted">
                            <i class="fas fa-inbox fa-3x mb-3"></i>
                            <p class="mb-0">Không tìm thấy danh mục nào</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Pagination -->
@if (Model.Categories.TotalPages > 1)
{
    <nav aria-label="Category pagination">
        <ul class="pagination justify-content-center">
            <!-- Previous -->
            <li class="page-item @(!Model.Categories.HasPreviousPage ? "disabled" : "")">
                <a class="page-link" href="#" onclick="loadPage(@(Model.Categories.PageNumber - 1)); return false;">
                    <i class="fas fa-chevron-left"></i>
                </a>
            </li>

            <!-- Page Numbers -->
            @{
                int startPage = Math.Max(1, Model.Categories.PageNumber - 2);
                int endPage = Math.Min(Model.Categories.TotalPages, Model.Categories.PageNumber + 2);
            }

            @if (startPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" href="#" onclick="loadPage(1); return false;">1</a>
                </li>
                @if (startPage > 2)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }
            }

            @for (int i = startPage; i <= endPage; i++)
            {
                <li class="page-item @(i == Model.Categories.PageNumber ? "active" : "")">
                    <a class="page-link" href="#" onclick="loadPage(@i); return false;">@i</a>
                </li>
            }

            @if (endPage < Model.Categories.TotalPages)
            {
                @if (endPage < Model.Categories.TotalPages - 1)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }
                <li class="page-item">
                    <a class="page-link" href="#" onclick="loadPage(@Model.Categories.TotalPages); return false;">@Model.Categories.TotalPages</a>
                </li>
            }

            <!-- Next -->
            <li class="page-item @(!Model.Categories.HasNextPage ? "disabled" : "")">
                <a class="page-link" href="#" onclick="loadPage(@(Model.Categories.PageNumber + 1)); return false;">
                    <i class="fas fa-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>

    <div class="text-center text-muted mb-3">
        <small>
            Hiển thị @((Model.Categories.PageNumber - 1) * Model.Categories.PageSize + 1) 
            - @(Math.Min(Model.Categories.PageNumber * Model.Categories.PageSize, Model.Categories.TotalCount))
            trong tổng số @Model.Categories.TotalCount danh mục
        </small>
    </div>
}
