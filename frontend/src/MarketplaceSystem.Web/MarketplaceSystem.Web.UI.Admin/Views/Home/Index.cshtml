@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Posts Chart
        const postsCtx = document.getElementById('postsChart').getContext('2d');
        const postsChart = new Chart(postsCtx, {
            type: 'line',
            data: {
                labels: ['T1', 'T2', 'T3', 'T4', 'T5', 'T6', 'T7', 'T8', 'T9', 'T10', 'T11', 'T12'],
                datasets: [{
                    label: 'Bài đăng đã duyệt',
                    data: [120, 150, 180, 220, 200, 245, 270, 290, 310, 280, 300, 245],
                    borderColor: 'rgb(28, 200, 138)',
                    backgroundColor: 'rgba(28, 200, 138, 0.2)',
                    tension: 0.4
                }, {
                    label: 'Bài đăng bị từ chối',
                    data: [10, 15, 12, 18, 14, 20, 16, 22, 19, 17, 21, 15],
                    borderColor: 'rgb(231, 74, 59)',
                    backgroundColor: 'rgba(231, 74, 59, 0.2)',
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: true,
                        position: 'top'
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });

        // Category Chart
        const categoryCtx = document.getElementById('categoryChart').getContext('2d');
        const categoryChart = new Chart(categoryCtx, {
            type: 'doughnut',
            data: {
                labels: ['Điện thoại', 'Laptop', 'Xe máy', 'Nhà đất', 'Đồ điện tử', 'Khác'],
                datasets: [{
                    data: [25, 20, 18, 15, 12, 10],
                    backgroundColor: [
                        'rgb(255, 99, 132)',
                        'rgb(54, 162, 235)',
                        'rgb(255, 205, 86)',
                        'rgb(75, 192, 192)',
                        'rgb(153, 102, 255)',
                        'rgb(201, 203, 207)'
                    ]
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                }
            }
        });

        // Approve/Reject handlers
        // Approve Post Function
        function approvePost(postId) {
            if (confirm('Bạn có chắc muốn duyệt bài đăng này?')) {
                // TODO: Gọi API để duyệt bài đăng
                // fetch(`/Post/Approve/${postId}`, { method: 'POST' })
                showNotification('Đã duyệt bài đăng!', 'success');
                // Reload hoặc remove row
                location.reload();
            }
        }

        // Reject Post Function
        function rejectPost(postId) {
            const reason = prompt('Lý do từ chối:');
            if (reason) {
                // TODO: Gọi API để từ chối bài đăng
                // fetch(`/Post/Reject/${postId}`, { 
                //     method: 'POST',
                //     body: JSON.stringify({ reason: reason })
                // })
                showNotification('Đã từ chối bài đăng!', 'warning');
                // Reload hoặc remove row
                location.reload();
            }
        }
    </script>
}
