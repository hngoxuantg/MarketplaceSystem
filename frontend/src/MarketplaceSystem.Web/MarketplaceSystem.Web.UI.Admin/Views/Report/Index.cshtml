                    </p>
                    <button class="btn btn-sm btn-info me-2" onclick="viewReportedPost(3)">
                        <i class="fas fa-eye"></i> Xem bài đăng
                    </button>
                    <button class="btn btn-sm btn-warning me-2" onclick="viewReporter(103)">
                        <i class="fas fa-user"></i> Xem người báo cáo
                    </button>
                    <button class="btn btn-sm btn-primary me-2" onclick="viewPostOwner(203)">
                        <i class="fas fa-user-tie"></i> Xem chủ bài đăng
                    </button>
                </div>
                <div class="col-md-4">
                    <div class="card bg-light">
                        <div class="card-body">
                            <h6 class="font-weight-bold mb-3">Xử lý báo cáo</h6>
                            <button class="btn btn-success w-100 mb-2" onclick="handleReport(3, 'delete_post')">
                                <i class="fas fa-trash"></i> Xóa bài đăng
                            </button>
                            <button class="btn btn-warning w-100 mb-2" onclick="handleReport(3, 'ban_user')">
                                <i class="fas fa-ban"></i> Khóa tài khoản
                            </button>
                            <button class="btn btn-danger w-100 mb-2" onclick="handleReport(3, 'both')">
                                <i class="fas fa-fire"></i> Xóa bài + Khóa TK
                            </button>
                            <button class="btn btn-secondary w-100" onclick="handleReport(3, 'reject')">
                                <i class="fas fa-times"></i> Từ chối (Báo cáo sai)
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pagination -->
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-end">
                <li class="page-item disabled">
                    <a class="page-link" href="#" tabindex="-1">Trước</a>
                </li>
                <li class="page-item active"><a class="page-link" href="#">1</a></li>
                <li class="page-item"><a class="page-link" href="#">2</a></li>
                <li class="page-item">
                    <a class="page-link" href="#">Sau</a>
                </li>
            </ul>
        </nav>
    </div>
</div>

<!-- Report Types -->
<div class="row">
    <div class="col-md-12">
        <div class="card shadow">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Phân loại báo cáo</h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3">
                        <div class="border-left-danger p-3">
                            <h6><i class="fas fa-mask text-danger"></i> Lừa đảo</h6>
                            <h4 class="mb-0">12 báo cáo</h4>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="border-left-warning p-3">
                            <h6><i class="fas fa-envelope text-warning"></i> Spam</h6>
                            <h4 class="mb-0">8 báo cáo</h4>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="border-left-info p-3">
                            <h6><i class="fas fa-image text-info"></i> Nội dung không phù hợp</h6>
                            <h4 class="mb-0">6 báo cáo</h4>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="border-left-secondary p-3">
                            <h6><i class="fas fa-copy text-secondary"></i> Sao chép/Vi phạm bản quyền</h6>
                            <h4 class="mb-0">7 báo cáo</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function handleReport(reportId, action) {
            let message = '';
            let confirmMsg = '';
            
            switch(action) {
                case 'delete_post':
                    confirmMsg = 'Xóa bài đăng này?';
                    message = 'Đã xóa bài đăng và đánh dấu báo cáo đã xử lý';
                    break;
                case 'ban_user':
                    confirmMsg = 'Khóa tài khoản người đăng bài?';
                    message = 'Đã khóa tài khoản và đánh dấu báo cáo đã xử lý';
                    break;
                case 'both':
                    confirmMsg = 'XÓA BÀI ĐĂNG và KHÓA TÀI KHOẢN?\nHành động này rất nghiêm trọng!';
                    message = 'Đã xóa bài đăng và khóa tài khoản';
                    break;
                case 'reject':
                    confirmMsg = 'Từ chối báo cáo này? (Đánh dấu là báo cáo sai)';
                    message = 'Đã từ chối báo cáo';
                    break;
            }
            
            const reason = prompt(confirmMsg + '\n\nNhập lý do xử lý (bắt buộc):');
            if (reason && reason.trim() !== '') {
                showNotification(message + ' #' + reportId + '. Lý do: ' + reason, 'success');
                // Hide the report item
                event.target.closest('.alert').style.opacity = '0.5';
                setTimeout(() => {
                    event.target.closest('.alert').remove();
                }, 500);
            } else if (reason !== null) {
                alert('Vui lòng nhập lý do xử lý!');
            }
        }

        function viewReportedPost(postId) {
            window.location.href = '/Post/Details/' + postId;
        }

        function viewReporter(userId) {
            window.location.href = '/User/Details/' + userId;
        }

        function viewPostOwner(userId) {
            window.location.href = '/User/Details/' + userId;
        }
    </script>
}
