@{
    ViewData["Title"] = "Quản lý Đơn hàng";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-2 mb-3 border-bottom">
    <h1 class="h2"><i class="fas fa-shopping-cart"></i> Quản lý Đơn hàng</h1>
    <div class="btn-toolbar mb-2 mb-md-0">
        <div class="btn-group me-2">
            <button type="button" class="btn btn-sm btn-outline-secondary active">Tất cả</button>
            <button type="button" class="btn btn-sm btn-outline-secondary">Chờ xử lý</button>
            <button type="button" class="btn btn-sm btn-outline-secondary">Đang giao</button>
            <button type="button" class="btn btn-sm btn-outline-secondary">Hoàn thành</button>
        </div>
    </div>
</div>

<!-- Search and Filter -->
<div class="row mb-3">
    <div class="col-md-6">
        <div class="input-group">
            <span class="input-group-text"><i class="fas fa-search"></i></span>
            <input type="text" class="form-control" placeholder="Tìm kiếm đơn hàng..." data-table-search>
        </div>
    </div>
    <div class="col-md-3">
        <select class="form-select">
            <option value="">Trạng thái</option>
            <option value="pending">Chờ xử lý</option>
            <option value="processing">Đang xử lý</option>
            <option value="shipping">Đang giao</option>
            <option value="completed">Hoàn thành</option>
            <option value="cancelled">Đã hủy</option>
        </select>
    </div>
    <div class="col-md-3">
        <input type="date" class="form-control">
    </div>
</div>

<!-- Orders Table -->
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Danh sách đơn hàng</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>Số điện thoại</th>
                        <th>Sản phẩm</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th>Ngày đặt</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong>#ORD-001</strong></td>
                        <td>Nguyễn Văn A</td>
                        <td>0901234567</td>
                        <td>iPhone 15 Pro Max (x1)</td>
                        <td><strong>29,990,000 ₫</strong></td>
                        <td><span class="badge bg-success">Hoàn thành</span></td>
                        <td>25/10/2025</td>
                        <td>
                            <a asp-action="Details" asp-route-id="1" class="btn btn-sm btn-info">
                                <i class="fas fa-eye"></i> Chi tiết
                            </a>
                        </td>
                    </tr>
                    <tr>
                        <td><strong>#ORD-002</strong></td>
                        <td>Trần Thị B</td>
                        <td>0909876543</td>
                        <td>MacBook Pro M3 (x1)</td>
                        <td><strong>45,990,000 ₫</strong></td>
                        <td><span class="badge bg-warning">Đang xử lý</span></td>
                        <td>25/10/2025</td>
                        <td>
                            <a asp-action="Details" asp-route-id="2" class="btn btn-sm btn-info">
                                <i class="fas fa-eye"></i> Chi tiết
                            </a>
                        </td>
                    </tr>
                    <tr>
                        <td><strong>#ORD-003</strong></td>
                        <td>Lê Văn C</td>
                        <td>0912345678</td>
                        <td>iPad Air 2024 (x1)</td>
                        <td><strong>15,990,000 ₫</strong></td>
                        <td><span class="badge bg-info">Đang giao</span></td>
                        <td>24/10/2025</td>
                        <td>
                            <a asp-action="Details" asp-route-id="3" class="btn btn-sm btn-info">
                                <i class="fas fa-eye"></i> Chi tiết
                            </a>
                        </td>
                    </tr>
                    <tr>
                        <td><strong>#ORD-004</strong></td>
                        <td>Phạm Thị D</td>
                        <td>0923456789</td>
                        <td>Apple Watch Series 9 (x2)</td>
                        <td><strong>19,980,000 ₫</strong></td>
                        <td><span class="badge bg-danger">Đã hủy</span></td>
                        <td>24/10/2025</td>
                        <td>
                            <a asp-action="Details" asp-route-id="4" class="btn btn-sm btn-info">
                                <i class="fas fa-eye"></i> Chi tiết
                            </a>
                        </td>
                    </tr>
                    <tr>
                        <td><strong>#ORD-005</strong></td>
                        <td>Hoàng Văn E</td>
                        <td>0934567890</td>
                        <td>Samsung Galaxy S24 Ultra (x1)</td>
                        <td><strong>24,990,000 ₫</strong></td>
                        <td><span class="badge bg-secondary">Chờ xử lý</span></td>
                        <td>25/10/2025</td>
                        <td>
                            <a asp-action="Details" asp-route-id="5" class="btn btn-sm btn-info">
                                <i class="fas fa-eye"></i> Chi tiết
                            </a>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        
        <!-- Pagination -->
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-end">
                <li class="page-item disabled">
                    <a class="page-link" href="#" tabindex="-1">Trước</a>
                </li>
                <li class="page-item active"><a class="page-link" href="#">1</a></li>
                <li class="page-item"><a class="page-link" href="#">2</a></li>
                <li class="page-item"><a class="page-link" href="#">3</a></li>
                <li class="page-item">
                    <a class="page-link" href="#">Sau</a>
                </li>
            </ul>
        </nav>
    </div>
</div>

<!-- Statistics -->
