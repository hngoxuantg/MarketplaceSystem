@{
    ViewData["Title"] = "Quản lý Sản phẩm";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-2 mb-3 border-bottom">
    <h1 class="h2"><i class="fas fa-box"></i> Quản lý Sản phẩm</h1>
    <div class="btn-toolbar mb-2 mb-md-0">
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Thêm sản phẩm mới
        </a>
    </div>
</div>

<!-- Search and Filter -->
<div class="row mb-3">
    <div class="col-md-8">
        <div class="input-group">
            <span class="input-group-text"><i class="fas fa-search"></i></span>
            <input type="text" class="form-control" placeholder="Tìm kiếm sản phẩm..." data-table-search>
        </div>
    </div>
    <div class="col-md-4">
        <select class="form-select">
            <option value="">Tất cả danh mục</option>
            <option value="1">Điện thoại</option>
            <option value="2">Laptop</option>
            <option value="3">Tablet</option>
            <option value="4">Phụ kiện</option>
        </select>
    </div>
</div>

<!-- Products Table -->
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Danh sách sản phẩm</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th width="60px">ID</th>
                        <th width="80px">Ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Danh mục</th>
                        <th>Giá</th>
                        <th>Số lượng</th>
                        <th>Trạng thái</th>
                        <th width="150px">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>1</td>
                        <td><img src="https://via.placeholder.com/50" alt="Product" class="img-thumbnail"></td>
                        <td>iPhone 15 Pro Max</td>
                        <td><span class="badge bg-info">Điện thoại</span></td>
                        <td>29,990,000 ₫</td>
                        <td>50</td>
                        <td><span class="badge bg-success">Còn hàng</span></td>
                        <td>
                            <a asp-action="Details" asp-route-id="1" class="btn btn-sm btn-info" title="Xem">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="1" class="btn btn-sm btn-primary" title="Sửa">
                                <i class="fas fa-edit"></i>
                            </a>
                            <button class="btn btn-sm btn-danger" data-confirm-delete title="Xóa">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                    <tr>
                        <td>2</td>
                        <td><img src="https://via.placeholder.com/50" alt="Product" class="img-thumbnail"></td>
                        <td>MacBook Pro M3</td>
                        <td><span class="badge bg-info">Laptop</span></td>
                        <td>45,990,000 ₫</td>
                        <td>30</td>
                        <td><span class="badge bg-success">Còn hàng</span></td>
                        <td>
                            <a asp-action="Details" asp-route-id="2" class="btn btn-sm btn-info" title="Xem">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="2" class="btn btn-sm btn-primary" title="Sửa">
                                <i class="fas fa-edit"></i>
                            </a>
                            <button class="btn btn-sm btn-danger" data-confirm-delete title="Xóa">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                    <tr>
                        <td>3</td>
                        <td><img src="https://via.placeholder.com/50" alt="Product" class="img-thumbnail"></td>
                        <td>iPad Air 2024</td>
                        <td><span class="badge bg-info">Tablet</span></td>
                        <td>15,990,000 ₫</td>
                        <td>0</td>
                        <td><span class="badge bg-danger">Hết hàng</span></td>
                        <td>
                            <a asp-action="Details" asp-route-id="3" class="btn btn-sm btn-info" title="Xem">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="3" class="btn btn-sm btn-primary" title="Sửa">
                                <i class="fas fa-edit"></i>
                            </a>
                            <button class="btn btn-sm btn-danger" data-confirm-delete title="Xóa">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                    <tr>
                        <td>4</td>
                        <td><img src="https://via.placeholder.com/50" alt="Product" class="img-thumbnail"></td>
                        <td>Apple Watch Series 9</td>
                        <td><span class="badge bg-info">Phụ kiện</span></td>
                        <td>9,990,000 ₫</td>
                        <td>75</td>
                        <td><span class="badge bg-success">Còn hàng</span></td>
                        <td>
                            <a asp-action="Details" asp-route-id="4" class="btn btn-sm btn-info" title="Xem">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="4" class="btn btn-sm btn-primary" title="Sửa">
                                <i class="fas fa-edit"></i>
                            </a>
                            <button class="btn btn-sm btn-danger" data-confirm-delete title="Xóa">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                    <tr>
                        <td>5</td>
                        <td><img src="https://via.placeholder.com/50" alt="Product" class="img-thumbnail"></td>
                        <td>Samsung Galaxy S24 Ultra</td>
                        <td><span class="badge bg-info">Điện thoại</span></td>
                        <td>24,990,000 ₫</td>
                        <td>40</td>
                        <td><span class="badge bg-success">Còn hàng</span></td>
                        <td>
                            <a asp-action="Details" asp-route-id="5" class="btn btn-sm btn-info" title="Xem">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="5" class="btn btn-sm btn-primary" title="Sửa">
                                <i class="fas fa-edit"></i>
                            </a>
                            <button class="btn btn-sm btn-danger" data-confirm-delete title="Xóa">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        
        <!-- Pagination -->
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-end">
                <li class="page-item disabled">
                    <a class="page-link" href="#" tabindex="-1">Trước</a>
                </li>
                <li class="page-item active"><a class="page-link" href="#">1</a></li>
                <li class="page-item"><a class="page-link" href="#">2</a></li>
                <li class="page-item"><a class="page-link" href="#">3</a></li>
                <li class="page-item">
                    <a class="page-link" href="#">Sau</a>
                </li>
            </ul>
        </nav>
    </div>
</div>
