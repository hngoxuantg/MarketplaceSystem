@{
    ViewData["Title"] = "Cài đặt hệ thống";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-2 mb-3 border-bottom">
    <h1 class="h2"><i class="fas fa-cog"></i> Cài đặt hệ thống</h1>
    <div class="btn-toolbar mb-2 mb-md-0">
        <button type="button" class="btn btn-primary" onclick="saveAllSettings()">
            <i class="fas fa-save"></i> Lưu tất cả thay đổi
        </button>
    </div>
</div>

<!-- Settings Tabs -->
<ul class="nav nav-tabs mb-4" id="settingsTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="general-tab" data-bs-toggle="tab" data-bs-target="#general" type="button">
            <i class="fas fa-wrench"></i> Cài đặt chung
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="approval-tab" data-bs-toggle="tab" data-bs-target="#approval" type="button">
            <i class="fas fa-check-circle"></i> Phê duyệt bài đăng
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="notification-tab" data-bs-toggle="tab" data-bs-target="#notification" type="button">
            <i class="fas fa-bell"></i> Thông báo
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="security-tab" data-bs-toggle="tab" data-bs-target="#security" type="button">
            <i class="fas fa-shield-alt"></i> Bảo mật
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="email-tab" data-bs-toggle="tab" data-bs-target="#email" type="button">
            <i class="fas fa-envelope"></i> Email
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="storage-tab" data-bs-toggle="tab" data-bs-target="#storage" type="button">
            <i class="fas fa-database"></i> Lưu trữ
        </button>
    </li>
</ul>

<!-- Tab Content -->
<div class="tab-content" id="settingsTabContent">
    <!-- General Settings -->
    <div class="tab-pane fade show active" id="general" role="tabpanel">
        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow mb-4">
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">Thông tin website</h6>
                    </div>
                    <div class="card-body">
                        <form>
                            <div class="mb-3">
                                <label class="form-label">Tên website</label>
                                <input type="text" class="form-control" value="RaoVặt.vn" placeholder="Tên website">
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Slogan</label>
                                <input type="text" class="form-control" value="Mua bán - Rao vặt miễn phí" placeholder="Slogan">
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Mô tả</label>
                                <textarea class="form-control" rows="3" placeholder="Mô tả website">Website rao vặt hàng đầu Việt Nam</textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Từ khóa SEO</label>
                                <input type="text" class="form-control" value="rao vặt, mua bán, chợ tốt" placeholder="Từ khóa cách nhau bởi dấu phẩy">
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Email liên hệ</label>
                                    <input type="email" class="form-control" value="contact@raovat.vn">
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Số điện thoại</label>
                                    <input type="tel" class="form-control" value="1900-xxxx">
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Địa chỉ</label>
                                <input type="text" class="form-control" value="123 Nguyễn Huệ, Q.1, TP.HCM">
                            </div>
                            <div class="mb-3 form-check">
                                <input type="checkbox" class="form-check-input" id="maintenanceMode">
                                <label class="form-check-label" for="maintenanceMode">
                                    <strong>Chế độ bảo trì</strong> - Tạm khóa website cho người dùng
                                </label>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card shadow mb-4">
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">Logo & Favicon</h6>
                    </div>
                    <div class="card-body text-center">
                        <div class="mb-3">
                            <label class="form-label">Logo website</label>
                            <div class="border rounded p-3 mb-2">
                                <img src="https://via.placeholder.com/200x80?text=LOGO" alt="Logo" class="img-fluid">
                            </div>
                            <button class="btn btn-sm btn-primary">
                                <i class="fas fa-upload"></i> Tải logo mới
                            </button>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Favicon</label>
                            <div class="border rounded p-3 mb-2">
                                <img src="https://via.placeholder.com/64?text=ICO" alt="Favicon" class="img-fluid">
                            </div>
                            <button class="btn btn-sm btn-primary">
                                <i class="fas fa-upload"></i> Tải favicon mới
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Approval Settings -->
    <div class="tab-pane fade" id="approval" role="tabpanel">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Cấu hình phê duyệt bài đăng</h6>
            </div>
            <div class="card-body">
                <form>
                    <div class="mb-4">
                        <label class="form-label"><strong>Chế độ phê duyệt</strong></label>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="approvalMode" id="autoApprove" checked>
                            <label class="form-check-label" for="autoApprove">
                                Tự động duyệt - Bài đăng hiển thị ngay sau khi đăng
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="approvalMode" id="manualApprove">
                            <label class="form-check-label" for="manualApprove">
                                Phê duyệt thủ công - Admin phải duyệt trước khi hiển thị
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="approvalMode" id="smartApprove">
                            <label class="form-check-label" for="smartApprove">
                                Phê duyệt thông minh - Dựa trên lịch sử và uy tín người dùng
                            </label>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Số bài đăng tối đa/ngày (mỗi user)</label>
                            <input type="number" class="form-control" value="10" min="1">
                            <small class="text-muted">Giới hạn số bài đăng mỗi người dùng có thể đăng trong 1 ngày</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Thời gian chờ duyệt tối đa (giờ)</label>
                            <input type="number" class="form-control" value="24" min="1">
                            <small class="text-muted">Thời gian tối đa chờ duyệt, sau đó tự động từ chối</small>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Từ khóa cấm (mỗi từ một dòng)</label>
                        <textarea class="form-control" rows="5" placeholder="Nhập từ khóa cấm...">lừa đảo
đa cấp
ma túy
vũ khí
hàng giả</textarea>
                        <small class="text-muted">Bài đăng chứa các từ này sẽ tự động bị từ chối</small>
                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="requirePhone" checked>
                        <label class="form-check-label" for="requirePhone">
                            Yêu cầu xác thực số điện thoại trước khi đăng bài
                        </label>
                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="requireEmail" checked>
                        <label class="form-check-label" for="requireEmail">
                            Yêu cầu xác thực email trước khi đăng bài
                        </label>
                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="autoRejectDuplicate" checked>
                        <label class="form-check-label" for="autoRejectDuplicate">
                            Tự động từ chối bài đăng trùng lặp
                        </label>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Notification Settings -->
    <div class="tab-pane fade" id="notification" role="tabpanel">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Cấu hình thông báo</h6>
            </div>
            <div class="card-body">
                <form>
                    <div class="mb-4">
                        <h6>Thông báo cho Admin</h6>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="notifyNewPost" checked>
                            <label class="form-check-label" for="notifyNewPost">
                                Có bài đăng mới chờ duyệt
                            </label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="notifyNewReport" checked>
                            <label class="form-check-label" for="notifyNewReport">
                                Có báo cáo vi phạm mới
                            </label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="notifyNewUser" checked>
                            <label class="form-check-label" for="notifyNewUser">
                                Có người dùng đăng ký mới
                            </label>
                        </div>
                    </div>

                    <div class="mb-4">
                        <h6>Thông báo cho User</h6>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="notifyPostApproved" checked>
                            <label class="form-check-label" for="notifyPostApproved">
                                Bài đăng được duyệt
                            </label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="notifyPostRejected" checked>
                            <label class="form-check-label" for="notifyPostRejected">
                                Bài đăng bị từ chối
                            </label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="notifyPostExpired">
                            <label class="form-check-label" for="notifyPostExpired">
                                Bài đăng sắp hết hạn
                            </label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="notifyNewMessage" checked>
                            <label class="form-check-label" for="notifyNewMessage">
                                Có tin nhắn mới
                            </label>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Kênh thông báo Email Admin</label>
                            <input type="email" class="form-control" value="admin@raovat.vn">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Số điện thoại nhận SMS (Admin)</label>
                            <input type="tel" class="form-control" value="0901234567">
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Security Settings -->
    <div class="tab-pane fade" id="security" role="tabpanel">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Cấu hình bảo mật</h6>
            </div>
            <div class="card-body">
                <form>
                    <div class="mb-4">
                        <h6>Xác thực người dùng</h6>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="require2FA">
                            <label class="form-check-label" for="require2FA">
                                Bắt buộc xác thực 2 yếu tố (2FA) cho Admin
                            </label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="requireCaptcha" checked>
                            <label class="form-check-label" for="requireCaptcha">
                                Yêu cầu CAPTCHA khi đăng nhập
                            </label>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Số lần đăng nhập sai tối đa</label>
                            <input type="number" class="form-control" value="5" min="3" max="10">
                            <small class="text-muted">Sau đó tài khoản sẽ bị khóa tạm thời</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Thời gian khóa tài khoản (phút)</label>
                            <input type="number" class="form-control" value="30" min="10">
                            <small class="text-muted">Thời gian khóa sau khi đăng nhập sai quá số lần cho phép</small>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Độ dài mật khẩu tối thiểu</label>
                            <input type="number" class="form-control" value="8" min="6">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Thời gian session (phút)</label>
                            <input type="number" class="form-control" value="120" min="30">
                        </div>
                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="requireStrongPassword" checked>
                        <label class="form-check-label" for="requireStrongPassword">
                            Yêu cầu mật khẩu mạnh (chữ hoa, chữ thường, số, ký tự đặc biệt)
                        </label>
                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="logUserActivity" checked>
                        <label class="form-check-label" for="logUserActivity">
                            Ghi log hoạt động người dùng
                        </label>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Email Settings -->
    <div class="tab-pane fade" id="email" role="tabpanel">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Cấu hình Email SMTP</h6>
            </div>
            <div class="card-body">
                <form>
                    <div class="mb-3">
                        <label class="form-label">SMTP Host</label>
                        <input type="text" class="form-control" value="smtp.gmail.com" placeholder="smtp.gmail.com">
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">SMTP Port</label>
                            <input type="number" class="form-control" value="587">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Mã hóa</label>
                            <select class="form-select">
                                <option>TLS</option>
                                <option>SSL</option>
                                <option>None</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email gửi</label>
                        <input type="email" class="form-control" value="noreply@raovat.vn">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tên người gửi</label>
                        <input type="text" class="form-control" value="RaoVặt.vn">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Username SMTP</label>
                        <input type="text" class="form-control" value="noreply@raovat.vn">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Password SMTP</label>
                        <input type="password" class="form-control" value="********">
                    </div>
                    <div class="mb-3">
                        <button type="button" class="btn btn-info" onclick="testEmail()">
                            <i class="fas fa-paper-plane"></i> Gửi email thử nghiệm
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Storage Settings -->
    <div class="tab-pane fade" id="storage" role="tabpanel">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Cấu hình lưu trữ</h6>
            </div>
            <div class="card-body">
                <form>
                    <div class="mb-4">
                        <label class="form-label"><strong>Loại lưu trữ</strong></label>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="storageType" id="localStorage" checked>
                            <label class="form-check-label" for="localStorage">
                                Local Storage - Lưu trên server
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="storageType" id="cloudStorage">
                            <label class="form-check-label" for="cloudStorage">
                                Cloud Storage - AWS S3, Azure, Google Cloud
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="storageType" id="cdnStorage">
                            <label class="form-check-label" for="cdnStorage">
                                CDN - Content Delivery Network
                            </label>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Kích thước file tối đa (MB)</label>
                            <input type="number" class="form-control" value="10" min="1">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Số ảnh tối đa/bài đăng</label>
                            <input type="number" class="form-control" value="8" min="1">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Định dạng ảnh cho phép</label>
                        <input type="text" class="form-control" value="jpg, jpeg, png, gif, webp">
                        <small class="text-muted">Các định dạng cách nhau bởi dấu phẩy</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Thư mục lưu trữ</label>
                        <input type="text" class="form-control" value="/uploads/posts/">
                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="autoResize" checked>
                        <label class="form-check-label" for="autoResize">
                            Tự động resize ảnh để tối ưu dung lượng
                        </label>
                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="watermark">
                        <label class="form-check-label" for="watermark">
                            Tự động thêm watermark vào ảnh
                        </label>
                    </div>

                    <div class="alert alert-info">
                        <h6><i class="fas fa-info-circle"></i> Thông tin dung lượng</h6>
                        <div class="row mt-3">
                            <div class="col-md-6">
                                <strong>Dung lượng đã dùng:</strong> 15.2 GB / 100 GB
                                <div class="progress mt-2">
                                    <div class="progress-bar" role="progressbar" style="width: 15.2%"></div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <strong>Số file:</strong> 12,450 files
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function saveAllSettings() {
            if (confirm('Bạn có chắc muốn lưu tất cả thay đổi?')) {
                // TODO: Gọi API để lưu settings
                showNotification('Đã lưu cài đặt thành công!', 'success');
            }
        }

        function testEmail() {
            const email = prompt('Nhập email để gửi thử:');
            if (email) {
                // TODO: Gọi API gửi test email
                showNotification('Đang gửi email thử nghiệm đến ' + email, 'info');
                setTimeout(() => {
                    showNotification('Email đã được gửi thành công!', 'success');
                }, 2000);
            }
        }

        // Auto-save draft
        let settingsChanged = false;
        document.querySelectorAll('input, select, textarea').forEach(el => {
            el.addEventListener('change', function() {
                settingsChanged = true;
            });
        });

        // Warn before leaving if there are unsaved changes
        window.addEventListener('beforeunload', function(e) {
            if (settingsChanged) {
                e.preventDefault();
                e.returnValue = '';
            }
        });
    </script>
}
